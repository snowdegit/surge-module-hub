http-response-jq (?i)^https://pre-match\.qiumibao\.com/pre_match_data/v\d/\d+-\d+-\d+/\d+_fund\.htm\? 'del(.data[] | select(.type == "guide"))'
http-response-jq (?i)^https://guess\.qiumibao\.com/api/c/menu$ '(. as $__original | try del(.data.banner) catch $__original)'
