[Body Rewrite]
http-response-jq (?i)^https://(app-v1\.ecoliving168\.com|852b95d36\.xwlpk\.cn)/api/v1/movie/index_recommend\? '.data[].list |= map(select(.type != 3)) | .data |= map(select(.layout != "advert_self"))'

[MITM]
hostname = %APPEND% app-v1.ecoliving168.com, 852b95d36.xwlpk.cn
h2 = true
