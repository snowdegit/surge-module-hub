#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=5EPlay去广告 · Surge iOS
#!desc=移除开屏广告、弹窗广告、活动角标、商城。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/5EPlay_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://app\.5eplay\.com/api/app/dync_config\? '(. as $__original | try del(.data.function_configs.startup_ad_switch) catch $__original) | (. as $__original | try del(.data.function_configs.startup_ad_timeout) catch $__original) | (. as $__original | try del(.data.function_configs.startup_ad_day_max) catch $__original) | (. as $__original | try del(.data.function_configs.app_bar_guide_width) catch $__original) | (. as $__original | try del(.data.function_configs.app_bar_guide_height) catch $__original) | (. as $__original | try del(.data.function_configs.app_bar_guide_url) catch $__original) | (. as $__original | try del(.data.function_configs.app_bar_guide_time) catch $__original) | (. as $__original | try del(.data.function_configs.home_tab_event_tag) catch $__original) | (. as $__original | try del(.data.function_configs.home_tab_event_tag_ext) catch $__original) | (. as $__original | try del(.data.function_configs.home_tab_player_tag) catch $__original) | (. as $__original | try del(.data.function_configs.home_tab_player_tag_ext) catch $__original) | (. as $__original | try del(.data.function_configs.task_center_entrance) catch $__original) | (. as $__original | try del(.data.function_configs.store_go) catch $__original) | (. as $__original | try del(.data.function_configs.wall_closed) catch $__original)'
http-response-jq (?i)^https://app\.5eplay\.com/api/index/tab_v\d\?category_id=tab_1&page=\d$ '(. as $__original | try del(.data.float_advertise) catch $__original)'
http-response-jq (?i)^https://ya-api-app\.5eplay\.com/v\d/search/config$ '(. as $__original | try del(.data.placeholder) catch $__original)'

[Map Local]
(?i)^https://ya-api-app\.5eplay\.com/v\d/search/kwd_top$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com
h2 = true
