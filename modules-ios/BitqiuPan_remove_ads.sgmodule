#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=比特球云盘去广告 · Surge iOS
#!desc=移除开屏广告和各类横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/BitqiuPan_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://pan-api\.bitqiu\.com/activity/getPromoteGuide$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^http://pan-api\.bitqiu\.com/activity/getUrlList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://pan-api\.bitqiu\.com/activity/guides$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% pan-api.bitqiu.com
h2 = true
