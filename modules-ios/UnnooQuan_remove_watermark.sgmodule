#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=知识星球去水印 · Surge iOS
#!desc=移除内容的水印编号
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/UnnooQuan_remove_watermark.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.zsxq\.com/v2/groups/\d+$ '.resp_data.group.policies.enable_watermark = false'

[Script]
UnnooQuan_remove_watermark-response = type=http-response, pattern="(?i)(?:^https://articles\\.zsxq\\.com/inline_form/id_[a-z0-9]+\\.html)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/UnnooQuan_remove_watermark-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.zsxq.com
h2 = true
