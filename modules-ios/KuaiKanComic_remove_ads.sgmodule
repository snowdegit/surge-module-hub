#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=快看漫画去广告 · Surge iOS
#!desc=移除开屏广告、悬浮窗、漫画广告、社区广告、各类弹窗，精简顶部标签、我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/KuaiKanComic_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ad.v3mh.com, REJECT
DOMAIN, ipv6.kkmh.com, REJECT
DOMAIN, ipv4.kkmh.com, REJECT

[Map Local]
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?h5\.kuaikanmanhua\.com/user/scene/api/new_user/sign_in/list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/business/activities/get data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/business/mine/business_config data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?topic\.kkmh\.com/gamecard/v\d/activityModule/userSignInInfo\?activitySignInConfigId data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?topic\.kkmh\.com/gamecard/v\d/activityModule/fetchButtonInfo\?buttonConfigId data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?topic\.kkmh\.com/gamecard/v\d/activityText/getUserActivityTextInfo\?activityTextConfigId data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/kb/comic_page_banner/detail data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/business/fake_push/info data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?shop\.kkmh\.com/mbff/popup_administration/page_management_popup_administration$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/business/mine/business_config data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/vip/banner_tip_list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/vip/charge_tip_list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://h5\.kuaikanmanhua\.com/v\d/kb/recharge_good/list_h5 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/kb/wallet data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/checkin/api/new_user/tab_info$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://h5\.kuaikanmanhua\.com/game-h5/new-user-welfare/index\.html data-type=text data="" status-code=200 header="Content-Type:text/plain"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/vip/platform_base/popups_display$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/checkin/task_center/get_by_task_type data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
KuaiKanComic_remove_ads-response = type=http-response, pattern="(?i)(?:^https://(cdn-)?api\\.kkmh\\.com/v\\d/ironman/comic/recommend)|(?:^https://(cdn-)?api\\.kkmh\\.com/v\\d/ironman/discovery_v\\d/tab_list_v\\d)|(?:^https://(cdn-)?social\\.kkmh\\.com/v\\d/graph/homepage/comicVideo/v\\d/configs)|(?:^https://(cdn-)?social\\.kkmh\\.com/v\\d/graph/unified_feed$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/KuaiKanComic_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.kkmh.com, cdn-api.kkmh.com, social.kkmh.com, cdn-social.kkmh.com, h5.kuaikanmanhua.com, cdn-h5.kuaikanmanhua.com, pay.kkmh.com, cdn-pay.kkmh.com, shop.kkmh.com, cdn-shop.kkmh.com, topic.kkmh.com, cdn-topic.kkmh.com
h2 = true
