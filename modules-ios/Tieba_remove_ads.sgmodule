#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=百度贴吧去广告 · Surge iOS
#!desc=移除开屏广告、信息流广告和帖内广告，精简侧拉抽屉及我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], app2smile[https://github.com/app2smile]
# Source: https://kelee.one/Tool/Loon/Lpx/Tieba_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, 180.76.76.200, REJECT
IP-CIDR, 180.76.76.200/32, REJECT, no-resolve

[Body Rewrite]
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/s/sync$ '(. as $__original | try del(.activity_switch) catch $__original) | (. as $__original | try del(.video_report_config) catch $__original) | (. as $__original | try del(.advertisement_config) catch $__original) | (. as $__original | try del(.next_start) catch $__original) | (. as $__original | try del(.push_strategy_new) catch $__original) | (. as $__original | try del(.live_activity_guide) catch $__original) | (. as $__original | try del(.h5_pop_ups) catch $__original) | (. as $__original | try del(.duxiaoman_url) catch $__original) | (. as $__original | try del(.is_need_remind_live_rooms) catch $__original) | (. as $__original | try del(.floating_icon) catch $__original) | (. as $__original | try del(.ad_stlog_switch) catch $__original) | (. as $__original | try del(.first_time_motivate) catch $__original) | (. as $__original | try del(.windowStrategyList) catch $__original) | (. as $__original | try del(.ad_adsense) catch $__original) | (. as $__original | try del(.ad_config) catch $__original) | (. as $__original | try del(.videoup_guide_pop) catch $__original) | (. as $__original | try del(.ad_origin_config_switch) catch $__original) | (. as $__original | try del(.needNewUserLead) catch $__original) | (. as $__original | try del(.h5_pop_ups_config) catch $__original) | (. as $__original | try del(.alaTabColor) catch $__original) | (. as $__original | try del(.search_guide) catch $__original) | (. as $__original | try del(.ad_sdk_priority) catch $__original) | (. as $__original | try del(.low_version_pop_config) catch $__original) | (. as $__original | try del(.ad_num_competition_frs) catch $__original) | (. as $__original | try del(.live_new_user_guide_day) catch $__original) | (. as $__original | try del(.screen_fill_data_result) catch $__original) | (. as $__original | try del(.yy_live_tab) catch $__original) | (. as $__original | try del(.ad_num_competition_personalize) catch $__original) | (. as $__original | try del(.complete_apk_url) catch $__original) | (. as $__original | try del(.user_activity) catch $__original) | (. as $__original | try del(.homepage_guide) catch $__original) | (. as $__original | try del(.bottom_bubble_config) catch $__original) | (. as $__original | try del(.home_screen_ad) catch $__original) | (. as $__original | try del(.afSearch_tab) catch $__original) | (. as $__original | try del(.recent_client_info) catch $__original) | (. as $__original | try del(.video_activity) catch $__original) | (. as $__original | try del(.namoaixud_url) catch $__original) | (. as $__original | try del(.yy_live_config) catch $__original) | (. as $__original | try del(.user_growth_task_list) catch $__original) | (. as $__original | try del(.cloud_control_data_info) catch $__original) | (. as $__original | try del(.wl_config.pb_banner_funad_cache_strategy) catch $__original) | (. as $__original | try del(.wl_config.pb_comment_asyncafd_cache_strategy) catch $__original) | (. as $__original | try del(.wl_config.download_edge_float) catch $__original) | (. as $__original | try del(.wl_config.download_pause_retain_dialog_conf) catch $__original) | (. as $__original | try del(.wl_config.download_mobile_dialog_conf) catch $__original) | (. as $__original | try del(.wl_config.download_fake_progress_config_a) catch $__original) | (. as $__original | try del(.wl_config.download_fake_progress_config_b) catch $__original) | (. as $__original | try del(.scheme_whitelist) catch $__original)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/s/sync$ '.wl_config.home_ad_num = 0 | .wl_config.frs_ad_num = 0 | .wl_config.pb_comment_ad_num = 0 | .wl_config.index_bear_density = 0 | .wl_config.frs_bear_density = 0 | .wl_config.index_bear_first_floor_max = 999999999 | .wl_config.index_bear_first_floor_min = 999999999'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/s/sync$ '.index_tab_info |= map(select(.tab_name == "推荐")) | .top_level_navi |= {"推荐": .["推荐"], "侧边栏": .["侧边栏"], "关注": .["关注"]}'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/u/user/profile$ '(. as $__original | try del(.url_map) catch $__original) | (. as $__original | try del(.user_agent_info) catch $__original) | (. as $__original | try del(.bubble_info) catch $__original) | (. as $__original | try del(.duxiaoman_entry) catch $__original) | (. as $__original | try del(.uc_card) catch $__original) | (. as $__original | try del(.finance_tab) catch $__original) | (. as $__original | try del(.vip_banner) catch $__original) | (. as $__original | try del(.ala_live_info) catch $__original) | (. as $__original | try del(.recom_naws_list) catch $__original) | (. as $__original | try del(.duxiaoman) catch $__original) | (. as $__original | try del(.user.consume_info) catch $__original) | (. as $__original | try del(.namoaixud_entry) catch $__original)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/u/user/profile$ '.user.shake_ad_switch.is_show = 0'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/u/user/profile$ '.custom_grid |= map(select(.title != "游戏大厅" and .title != "预约管理" and .title != "领话费" and .title != "短故事")) | .zone_info |= map(.common_func |= (if .common_func_noraml then .common_func_noraml |= map(select(.name != "创建智能体")) else . end)) | .zone_info |= map(select(.type != "commerce" and .type != "banner" and .type != "game"))'
http-response-jq (?i)^https?://tieba\.baidu\.com/c/f/forum/forumGuide$ '(. as $__original | try del(.hot_search) catch $__original)'
http-response-jq (?i)^https?://tieba\.baidu\.com/c/f/frs/frsBottom\? '(. as $__original | try del(.card_activity) catch $__original)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/f/frs/frsBottom$ '(. as $__original | try del(.card_activity) catch $__original)'
http-response-jq (?i)^https?://tiebac\.baidu\.com/c/f/sidebar/home$ '(. as $__original | try del(.game_center) catch $__original) | (. as $__original | try del(.tools) catch $__original) | (. as $__original | try del(.task_list) catch $__original) | (. as $__original | try del(.vip_banner) catch $__original)'

[Map Local]
(?i)^https?://tiebac\.baidu\.com/c/f/forum/getInterestClassList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://tiebac\.baidu\.com/c/f/search/discover$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://tieba\.baidu\.com/mo/q/search/startPage\? data-type=text data="{\"no\":0,\"error\":\"success\"}" status-code=200 header="Content-Type:application/json"
(?i)^https?://tieba\.baidu\.com/c/f/search/discover$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://tieba\.baidu\.com/c/f/forum/getForumAlbum$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^http://c\.tieba\.baidu\.com/c/f/forum/hotforum$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
Tieba_remove_ads-response = type=http-response, pattern="(?i)(?:^https?://tieba(?:c)?\\.baidu\\.com/c/(f/excellent/personalized|f/frs/page|b/ad/adBid|f/ad/getFeedAd|f/pb/page|f/frs/generalTabList)\\?cmd=\\d+&format=protobuf)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Tieba_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10, argument="{\"per_filter_video_thread\":\"true\"}"

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
h2 = true
