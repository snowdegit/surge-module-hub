#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=Apple天气增强 · Surge iOS
#!desc=解锁Apple天气的全部功能、替换空气质量数据源、添加下一小时降水数据、添加天气数据。
#!author=VirgilClyne[https://github.com/VirgilClyne], WordlessEcho[https://github.com/WordlessEcho], 001[https://github.com/001ProMax]
# Source: https://kelee.one/Tool/Loon/Lpx/AppleWeatherEnhancer.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, weather-analytics-events.apple.com, REJECT-DROP
DOMAIN, tether.edge.apple, REJECT-DROP
DOMAIN-SUFFIX, tthr.apple.com, REJECT-DROP
AND, ((OR, ((IP-ASN, 714, no-resolve), (IP-ASN, 6185, no-resolve))), (PROTOCOL, QUIC)), REJECT-DROP

[Script]
AppleWeatherEnhancer-response = type=http-response, pattern="(?i)(?:^https?://weatherkit\\.apple\\.com/api/v1/availability/)|(?:^https?://weatherkit\\.apple\\.com/api/v2/weather/)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/AppleWeatherEnhancer-response.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10, argument="{\"Weather.Provider\":\"ColorfulClouds\",\"NextHour.Provider\":\"ColorfulClouds\",\"AirQuality.Calculate.Algorithm\":\"EU_EAQI\",\"API.ColorfulClouds.Token\":\"\",\"API.QWeather.Host\":\"devapi.qweather.com\",\"API.QWeather.Token\":\"\",\"API.WAQI.Token\":\"\",\"Storage\":\"Argument\",\"LogLevel\":\"WARN\"}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
h2 = true
