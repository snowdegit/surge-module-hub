#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=口袋壁纸去广告 · Surge iOS
#!desc=移除悬浮广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/ShoujiDesk_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://api\.tdz5\.com/search/hotword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.tdz5\.com/ring/hot\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ShoujiDesk_remove_ads-response = type=http-response, pattern="(?i)(?:^https://api\\.tdz5\\.com/base/init\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/ShoujiDesk_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.tdz5.com
h2 = true
