#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=米游社去广告 · Surge iOS
#!desc=移除开屏广告、搜索栏热搜及资讯、青少年模式弹窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/miHoYoBBS_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppStartupData$ '(. as $__original | try del(.data.resp_map["/teenager/api/info"]) catch $__original) | (. as $__original | try del(.data.resp_map["/apihub/api/getAppConfig"].data.get_app_config_response.config.is_show_teenager_mode_btn) catch $__original) | (. as $__original | try del(.data.resp_map["/apihub/api/getAppConfig"].data.get_app_config_response.config.teenager_popup_freq_type) catch $__original)'
http-response-jq (?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppConfig$ '.data.config.teenager_popup_freq_type = 0 | .data.config.is_show_teenager_mode_btn = 0'
http-response-jq (?i)^https://bbs-api-ab\.miyoushe\.com/teenager/api/info$ '.data.is_enabled = false | .data.is_teenager = false | .data.is_force = false'

[Map Local]
(?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppSplash$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getHotKeywordAndEvent$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bbs-api-static\.miyoushe\.com/search/api/search/pre_keyword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% bbs-api.miyoushe.com, bbs-api-ab.miyoushe.com
h2 = true
