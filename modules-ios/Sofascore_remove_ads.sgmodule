#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=Sofascore去广告 · Surge iOS
#!desc=移除横幅及信息流广告
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Sofascore_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://api\.sofascore\.com/api/v\d/dsp/country/[A-Z]{2}$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.sofascore\.com/api/v\d/trending/grid/tiles/[A-Z]{2}$ data-type=text data="{\"tiles\":[]}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.sofascore.com
h2 = true
