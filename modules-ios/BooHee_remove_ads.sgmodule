#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=薄荷健康去广告 · Surge iOS
#!desc=移除记录页大家都在看、移除各类弹窗，移除广场横幅推广，精简代谢中心页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/BooHee_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.boohee\.com/meta-interface/v2/index\? '(. as $__original | try del(.data.recom_cards) catch $__original) | (. as $__original | try del(.data.recom_btns) catch $__original)'
http-response-jq (?i)^https://api\.boohee\.com/meta-interface/v1/index/plaza\? '(. as $__original | try del(.data.tabs[1].badge) catch $__original) | (. as $__original | try del(.data.recommend_ads) catch $__original)'
http-response-jq (?i)^https://api\.boohee\.com/open-interface/v1/string/market_page\?title=metabolism_config$ '(. as $__original | try del(.top_banner) catch $__original) | (. as $__original | try del(.diagnos_config) catch $__original) | (. as $__original | try del(.partner_hospital) catch $__original) | (. as $__original | try del(.question_answer) catch $__original) | (. as $__original | try del(.product) catch $__original) | (. as $__original | try del(.brand_story) catch $__original)'

[Map Local]
(?i)^https://api\.boohee\.com/meta-interface/v1/index/page_float_bubbles\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.boohee\.com/meta-interface/v1/index/tool_buttons\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.boohee\.com/app-interface/v1/search/search\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://status\.boohee\.com/api/v1/merged_messages$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn/api/v2/sfo/user_popup_configs\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.boohee\.com/meta-interface/v1/index/sensor-banners\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
BooHee_remove_ads-response = type=http-response, pattern="(?i)(?:^https://api\\.boohee\\.com/meta-interface/v1/index/plaza-flow\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/BooHee_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.boohee.com, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn, lego.boohee.com, status.boohee.com
h2 = true
