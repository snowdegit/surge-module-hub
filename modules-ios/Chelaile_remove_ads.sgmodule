#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=车来了去广告 · Surge iOS
#!desc=清洗配置，移除开屏广告、首页金刚位、文章推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Chelaile_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ad.chelaile.net.cn, REJECT

[Map Local]
(?i)^https://api\.chelaile\.net\.cn/goocity/flowPos/home\? data-type=text data="**YGKJ{\"jsonr\":{\"status\":\"00\",\"data\":{\"advertList\":[{\"id\":106,\"title\":\"站点地图\",\"iconUrl\":\"https://image3.chelaile.net.cn/89iIqxaM.png\",\"linkUrl\":\"\",\"adType\":5,\"showRedDot\":0,\"updateTime\":0,\"appId\":\"\",\"appPath\":\"\",\"bubbleOrder\":0,\"h5Type\":0},{\"id\":1,\"title\":\"地铁\",\"iconUrl\":\"https://image3.chelaile.net.cn/rewrLCWY.png\",\"linkUrl\":\"https://web.chelaile.net.cn/metro/index.html?h5_stats_referer=icon\",\"adType\":2,\"showRedDot\":0,\"updateTime\":0,\"appId\":\"\",\"appPath\":\"\",\"bubbleOrder\":0,\"h5Type\":0}]}}}YGKJ##" status-code=200 header="Content-Type:text/plain; charset=utf-8"
(?i)^https://api\.chelaile\.net\.cn/goocity/flowPos/listByPos\? data-type=text data="**YGKJ{}YGKJ##" status-code=200 header="Content-Type:text/plain; charset=utf-8"
(?i)^https://web\.chelaile\.net\.cn/api/operative_position/infoflow/getInfo\? data-type=text data="**YGKJ{}YGKJ##" status-code=200 header="Content-Type:text/plain; charset=utf-8"
(?i)^https://cdn\.web\.chelaile\.net\.cn/info-flow/index\.html\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://image3\.chelaile\.net\.cn/hw6u6LYY\.png$ data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"
(?i)^https://api\.chelaile\.net\.cn/led-weather/v\d/condition_brief\? data-type=text data="**YGKJ{}YGKJ##" status-code=200 header="Content-Type:text/plain; charset=utf-8"
(?i)^https://api\.chelaile\.net\.cn/goocity/config/notices\? data-type=text data="**YGKJ{}YGKJ##" status-code=200 header="Content-Type:text/plain; charset=utf-8"
(?i)^https://api\.chelaile\.net\.cn/encourage/activity/control\? data-type=text data="**YGKJ{}YGKJ##" status-code=200 header="Content-Type:text/plain; charset=utf-8"

[Script]
Chelaile_remove_ads-response = type=http-response, pattern="(?i)(?:^https://api\\.chelaile\\.net\\.cn/bus-side/appToggle/getStatus\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Chelaile_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.chelaile.net.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, image3.chelaile.net.cn
h2 = true
