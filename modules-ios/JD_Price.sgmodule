#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=京东比价 · Surge iOS
#!desc=首次使用需安装慢慢买应用，之后点击进入[我的]页面以捕获Cookie，捕获成功后方可在商品详情页面查看比价内容。
#!author=wf021325[https://github.com/wf021325], githubdulong[https://github.com/githubdulong], mw418[https://github.com/mw418]
# Source: https://kelee.one/Tool/Loon/Lpx/JD_Price.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
JD_Price-request = type=http-request, pattern="(?i)(?:^https?://apapia-sqk-weblogic\\.manmanbuy\\.com/baoliao/center/menu$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/JD_Price-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10
JD_Price-response = type=http-response, pattern="(?i)(?:^https?://in\\.m\\.jd\\.com/product/graphext/\\d+\\.html)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/JD_Price-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
h2 = true
