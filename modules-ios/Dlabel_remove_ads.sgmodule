#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=Dlabel云标签去广告 · Surge iOS
#!desc=移除开屏广告及首页横幅。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Dlabel_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://dlabel\.ctaiot\.com/api/spreadstart/list\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://dlabel\.ctaiot\.com/api/spread/journey/select\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% dlabel.ctaiot.com
h2 = true
