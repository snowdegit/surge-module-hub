#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=百度网页去广告 · Surge iOS
#!desc=移除百度搜索移动端网页的首页广告信息流
#!author=Keywos[https://github.com/Keywos]
# Source: https://kelee.one/Tool/Loon/Lpx/BaiduSearchWebpage_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
BaiduSearchWebpage_remove_ads-response = type=http-response, pattern="(?i)(?:^https?://(www|m)\\.baidu\\.com/?($|\\?from=\\w{8,9}))", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/BaiduSearchWebpage_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% m.baidu.com, www.baidu.com
h2 = true
