#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=美丽修行去广告 · Surge iOS
#!desc=移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Meizhixiuxing_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/page$ '(. as $__original | try del(.result.versionPopUp) catch $__original) | (. as $__original | try del(.result.isShowSearchLabel) catch $__original) | (. as $__original | try del(.result.isShowSearchFeedBack) catch $__original) | (. as $__original | try del(.result.centerBannerAdvert) catch $__original) | (. as $__original | try del(.result.programmaticAdvertising) catch $__original) | (. as $__original | try del(.result.mattsData) catch $__original) | (. as $__original | try del(.result.questionnaireMap) catch $__original) | (. as $__original | try del(.result.appPullDownAdvert) catch $__original)'
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/feed$ '(. as $__original | try del(.result.banners) catch $__original)'
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/feed$ '. | .result.returnList |= (map(select(.tname == "userPart"))) | .result.returnList |= map(select(. | has("adId") | not))'
http-response-jq (?i)^https://api\.bevol\.com/trialbox/shop/app/homePage$ '(. as $__original | try del(.result.firstPersonActivity) catch $__original) | (. as $__original | try del(.result.mainActivity) catch $__original) | (. as $__original | try del(.result.brandZone) catch $__original) | (. as $__original | try del(.result.imageAD2) catch $__original) | (. as $__original | try del(.result.couponPopupInfo) catch $__original)'

[Map Local]
(?i)^https://api\.bevol\.com/appmain/app/home/launch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/appmain/app/home/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/personal/page$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/seach/foundAndTopSearch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.bevol.com
h2 = true
