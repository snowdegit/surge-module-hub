#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=YouTube去广告 · Surge iOS
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
# Source: https://kelee.one/Tool/Loon/Lpx/YouTube_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
YouTube_remove_ads-request = type=http-request, pattern="(?i)(?:^https?://[\\w-]+\\.googlevideo\\.com/initplayback.+&ack.*)|(?:^https://youtubei\\.googleapis\\.com/youtubei/v1/log_event)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/YouTube_remove_ads-request.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10, argument="{\"blockUpload\":\"false\",\"blockShorts\":\"false\",\"blockImmersive\":\"false\",\"captionLang\":\"zh-Hans\",\"debug\":\"false\"}"
YouTube_remove_ads-response = type=http-response, pattern="(?i)(?:^https://youtubei\\.googleapis\\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\\?(.*))?$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/YouTube_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10, argument="{\"blockUpload\":\"false\",\"blockShorts\":\"false\",\"blockImmersive\":\"false\",\"captionLang\":\"zh-Hans\",\"debug\":\"false\"}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
h2 = true
