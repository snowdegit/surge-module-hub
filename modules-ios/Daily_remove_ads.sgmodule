[Body Rewrite]
http-response-jq (?i)^https?://m\.pvp\.xoyo\.com/conf/server-mapping$ '(. as $__original | try del(.data.splashConf) catch $__original) | (. as $__original | try del(.data.splashConfNew) catch $__original)'

[MITM]
hostname = %APPEND% m.pvp.xoyo.com
h2 = true
