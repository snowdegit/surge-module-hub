#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=网易大神去广告 · Surge iOS
#!desc=移除开屏广告，精简大量冗余的配置文件，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/NetEaseGodlike_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://god\.gameyw\.netease\.com/v\d/ad data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
NetEaseGodlike_remove_ads-response = type=http-response, pattern="(?i)(?:^https://app-conf\\.ds\\.163\\.com/v1/app/base/conf/static/start-config\\?os=ios)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/NetEaseGodlike_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% god.gameyw.netease.com, app-conf.ds.163.com
h2 = true
