#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=快捷搜索 · Surge iOS
#!desc=为Safari提供快速切换搜索引擎的能力，在插件列表中点击此插件上的链接查看使用方法。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/QuickSearch.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
QuickSearch-request = type=http-request, pattern="(?i)(?:^https://duckduckgo\\.com/\\?q=bd\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=bdimg\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=gimg\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=b\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=wk\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=qm\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=gh\\+([^&]+).+)|(?:^https://duckduckgo\\.com/\\?q=(?!(?:bd|bdimg|gimg|b|wk|qm|gh)\\+)([^&]+).+)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/QuickSearch-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% duckduckgo.com
h2 = true
