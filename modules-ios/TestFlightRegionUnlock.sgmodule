#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=TestFlight地区解锁 · Surge iOS
#!desc=解除TestFlight的区域限制，支持tvOS。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/TestFlightRegionUnlock.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, testflight.apple.com, PROXY

[Script]
TestFlightRegionUnlock-request = type=http-request, pattern="(?i)(?:^https?://testflight\\.apple\\.com/v\\d/accounts/.+?/install$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/TestFlightRegionUnlock-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% testflight.apple.com
h2 = true
