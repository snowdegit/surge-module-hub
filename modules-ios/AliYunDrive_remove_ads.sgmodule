#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=阿里云盘去广告 · Surge iOS
#!desc=移除首页广告横幅、弹窗和顶部奖励。
#!author=RuCu6[https://github.com/RuCu6]
# Source: https://kelee.one/Tool/Loon/Lpx/AliYunDrive_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
IP-CIDR, 203.107.1.1/24, REJECT, no-resolve

[Map Local]
(?i)^https://member\.alipan\.com/v2/activity/sign_in_luckyBottle data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.alipan\.com/adrive/v1/file/getTopFolders data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
AliYunDrive_remove_ads-response = type=http-response, pattern="(?i)(?:^https://(biz)?api\\.alipan\\.com/apps/v\\d/users?/home/(news|widgets))|(?:^https://member\\.alipan\\.com/v1/users/onboard_list)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/AliYunDrive_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.alipan.com, member.alipan.com, bizapi.alipan.com
h2 = true
