#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=行者户外去广告 · Surge iOS
#!desc=移除弹窗广告、发现页面横幅推广的推广金刚位，移除我的页面横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/OnTheWay_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://www\.imxingzhe\.com/api/v4/account/get_user_info\? '(. as $__original | try del(.banner) catch $__original)'
http-response-jq (?i)^https://www\.imxingzhe\.com/api/v4/discovery/ios/\? '(. as $__original | try del(.banners) catch $__original) | (. as $__original | try del(.ad) catch $__original)'
http-response-jq (?i)^https://www\.imxingzhe\.com/api/v4/discovery/ios/\? '.display_areas |= map(select(.name == "赛事" or .name == "行者帮" or .name == "头条" or .name == "排行榜" or .name == "约伴"))'

[Map Local]
(?i)^https://www\.imxingzhe\.com/api/v1/pop/window/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% www.imxingzhe.com
h2 = true
