#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=直播吧去广告 · Surge iOS
#!desc=移除信息流广告、横幅广告、弹窗广告、皮肤配置、悬浮挂件、热门搜索，移除青少年模式，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Zhibo8_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://headline\.qiumibao\.com/recommend/list\? '.news|=map(select(.model=="news" or .model=="video"))'
http-response-jq (?i)^https://a\.qiumibao\.com/found/\? 'map(select(.is_game != true))'
http-response-jq (?i)^https://a\.qiumibao\.com/ios/config/\? '(. as $__original | try del(.skin) catch $__original) | (. as $__original | try del(.advert) catch $__original) | (. as $__original | try del(.advert_config) catch $__original) | (. as $__original | try del(.mall) catch $__original) | (. as $__original | try del(.httpdns) catch $__original) | (. as $__original | try del(.reward) catch $__original) | (. as $__original | try del(.pgame) catch $__original) | (. as $__original | try del(.corner_mark) catch $__original) | (. as $__original | try del(.liveshop) catch $__original) | (. as $__original | try del(.theme) catch $__original) | (. as $__original | try del(.pop) catch $__original) | (. as $__original | try del(.live_activity_push) catch $__original)'
http-response-jq (?i)^https://a\.qiumibao\.com/ios/config/\? '.all_sections.match_sections.labels |= (if . then (.blacks_disable |= if . then map(select(. != "游戏")) else . end) | (.show |= if . then map(select(. != "游戏")) else . end) else . end)'
http-response-jq (?i)^https://guess\.qiumibao\.com/api/n/rcd$ '(. as $__original | try del(.data.banner) catch $__original)'
http-response-jq (?i)^https://pre-match\.qiumibao\.com/pre_match_data/v\d/\d+-\d+-\d+/\d+_fund\.htm\? 'del(.data[] | select(.type == "guide"))'
http-response-jq (?i)^https://guess\.qiumibao\.com/api/c/menu$ '(. as $__original | try del(.data.banner) catch $__original)'
http-response-jq (?i)^https://s\.qiumibao\.com/m/ios/json/zhibo/zuqiu/\d+/match\d+vl\.htm\? '(. as $__original | try del(.ep_v2) catch $__original) | (. as $__original | try del(.ep_live) catch $__original)'

[Map Local]
(?i)^https://rn\.qiumibao\.com/news/relation\.php$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://guess\.qiumibao\.com/api/c/notice$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://guess\.qiumibao\.com/api/c/pop$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://guess\.qiumibao\.com/api/ep/pop$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://guess\.qiumibao\.com/api/c/banner$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://search\.qiumibao\.com/hot/word_list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% headline.qiumibao.com, a.qiumibao.com, rn.qiumibao.com, guess.qiumibao.com, s.qiumibao.com, pre-match.qiumibao.com, search.qiumibao.com
h2 = true
