#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=启信宝去广告 · Surge iOS
#!desc=移除开屏广告、应用内弹窗、首页轮播图、悬浮部件和个性化推荐信息流。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/QiXinBao_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://appc\.qixin\.com/v4/general/getSearchPlaceholderRedirect$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/general/getAppFloatAd$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/general/getAppBanners$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/user/getUserActivitys$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/enterprise/homePageRecommend/recommendCard\d+ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/user/getRecommendPersons$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/enterprise/getRecommendEnts$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/enterprise/getRecommendation$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appc-v6\.qixin\.com/v4/general/getAppBottomBanners$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://qxb-minicode-pic-osscache\.qixin\.com/web/ data-type=text data="" status-code=404 header="Content-Type:text/plain"

[MITM]
hostname = %APPEND% appc.qixin.com, appc-v6.qixin.com, qxb-minicode-pic-osscache.qixin.com
h2 = true
