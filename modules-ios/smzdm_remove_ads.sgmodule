#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=什么值得买去广告 · Surge iOS
#!desc=移除开屏广告、信息流广告、各类横幅广告、搜索页广告、文章内广告，移除活动皮肤、精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/smzdm_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, adx-api.zdmimg.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https://app-api\.smzdm\.com/util/update$ '.data.silence_local_push = 0 | .data.baichuan_redirect_switch = 0'
http-response-jq (?i)^https://app-api\.smzdm\.com/util/update$ '(. as $__original | try del(.data.silence_local_push_msg) catch $__original) | (. as $__original | try del(.data.video_cache_num_configs) catch $__original) | (. as $__original | try del(.data.haojia_widget) catch $__original) | (. as $__original | try del(.data.widget) catch $__original) | (. as $__original | try del(.data.operation_float) catch $__original)'
http-response-jq (?i)^https://app-api\.smzdm\.com/util/update$ 'def r: if type=="object" then if has("ad_campaign_name") and (.ad_campaign_name|type=="string") and (.ad_campaign_name|test("\\S")) then empty else . end elif type=="array" then map(r) else . end; .data.operation_float |= map(map(r))'
http-response-jq (?i)^https://homepage-api\.smzdm\.com/v3/home\? '   .data.component |= map(      if (.zz_content | type) == "array" then     .zz_content |= map(       select(         ( (.ad_campaign_id? | type == "string" and length > 0) // false ) or         ( (.tag? | type == "string" and length > 0) // false ) or         ( (.model_type? == "ads" and (type == "string")) // false )         | not       )     )   else . end )   | .data.component |= map(   select(.zz_type == "circular_banner" or .zz_type == "filter" or .zz_type == "list") )   | .data.component |= map(   .zz_content |= (     if type == "array" then       map(         if type == "object" and (.article_channel_type // "") == "questionnaire" then           empty         else           .         end       )     else       .     end   ) )    | del(.data.theme)   | .data.component |= map(   if .zz_content | type == "object" then     .zz_content |= del(.circular_banner_option)   else     .   end )'
http-response-jq (?i)^https://haojia-api\.smzdm\.com/home/list\? '(. as $__original | try del(.data.header_operation.theme) catch $__original)'
http-response-jq (?i)^https://haojia-api\.smzdm\.com/home/list\? '.data.rows |= map(select(.cell_type == "39001")) | .data.banner_v2 |= map(select(.cell_type == "21028"))'
http-response-jq (?i)^https://haojia\.m\.smzdm\.com/detail_modul/user_related_modul\? '(. as $__original | try del(.data.super_coupon) catch $__original)'
http-response-jq (?i)^https://haojia\.m\.smzdm\.com/detail_modul/other_modul\? '(. as $__original | try del(.data.banner) catch $__original)'
http-response-jq (?i)^https://user-api\.smzdm\.com/vip$ '(. as $__original | try del(.data.activity_entrance_info) catch $__original) | (. as $__original | try del(.data.big_banner) catch $__original) | (. as $__original | try del(.data.top_banner) catch $__original) | (. as $__original | try del(.data.banner_switch) catch $__original) | (. as $__original | try del(.data.yaoqingshaiwu) catch $__original) | (. as $__original | try del(.data.right_info) catch $__original)'
http-response-jq (?i)^https://s-api\.smzdm\.com/sou/list_v10\? '.data.rows |= map(select(.model_type != "ads")) | .data.top_aladdin |= map(select(has("ad") | not))'
http-response-jq (?i)^https://s-api\.smzdm\.com/sou/filter/tags/hot_tags\? '(. as $__original | try del(.data.search_faxian) catch $__original) | (. as $__original | try del(.data.tonglan) catch $__original) | (. as $__original | try del(.data.hongbao) catch $__original)'
http-response-jq (?i)^https://s-api\.smzdm\.com/sou/filter/tags/hot_tags\? '.data.hot_tab |= (if type == "array" then map(select(.search_method != "热点主题榜")) else . end) | if .data.hot_tab then .data.hot_tab |= map(if .search_method == "热搜榜搜索热榜" and .rows then .rows |= map(select(.pos != null and ((.pos | tonumber) != null))) else . end) else . end'
http-response-jq (?i)^https://haojia-api\.smzdm\.com/detail/\d+\? '(. as $__original | try del(.data.quan_log) catch $__original)'
http-response-jq (?i)^https://haojia-cdn\.smzdm\.com/preload/\d+/fiphone/v\d+_\d+_\d+/wx\d+/im\d+/[0-9a-z]+/[0-9a-z]+\.json$ '(. as $__original | try del(.data.quan_log) catch $__original)'
http-response-jq (?i)^https://post\.m\.smzdm\.com/ajax_app/ajax_get_footer_list\? '(. as $__original | try del(.data.tuiguang_ad) catch $__original) | (. as $__original | try del(.data.activity_banner) catch $__original)'

[Map Local]
(?i)^https://app-api\.smzdm\.com/util/loading\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app-api\.smzdm\.com/mychannel/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://h5\.smzdm\.com/user/coupon/coupon_list\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://user-api\.smzdm\.com/vip/bottom_card_list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://article-api\.smzdm\.com/publish/get_bubble\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://s-api\.smzdm\.com/sou/search_default_keyword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://s-api\.smzdm\.com/sou/popup_coupon\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app-api.smzdm.com, homepage-api.smzdm.com, h5.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, user-api.smzdm.com, article-api.smzdm.com, s-api.smzdm.com, haojia-cdn.smzdm.com, post.m.smzdm.com
h2 = true
