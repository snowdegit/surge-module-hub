#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=ZAKER去广告 · Surge iOS
#!desc=移除开屏广告、置顶轮播图广告和文末广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/ZAKER_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://iphone\.myzaker\.com/zaker/article_mongo_sec\.php\? '(. as $__original | try del(.data.ad_url) catch $__original)'
http-response-jq (?i)^https://ggs\.myzaker\.com/zk_article_ad\.php\? '(. as $__original | try del(.data.article_bottom) catch $__original) | (. as $__original | try del(.data.recommend_ad) catch $__original)'
http-response-jq (?i)^https://iphone\.myzaker\.com/zaker/follow_promote\.php\? '.data.list |= map(select(.type != "web"))'
http-response-jq (?i)^https://iphone\.myzaker\.com/zaker/car_tab/index\.php\? '.data.gallery |= map(select(.type != "web"))'

[Map Local]
(?i)^https://iphone\.myzaker\.com/zaker/cover\.php\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://iphone\.myzaker\.com/zaker/block_top_ad\.php\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% iphone.myzaker.com, ggs.myzaker.com
h2 = true
