#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=BoxJs · Surge iOS
#!desc=JavaScript数据管理器，用于管理脚本储存的数据。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=chavyleung[https://github.com/chavyleung]
# Source: https://kelee.one/Tool/Loon/Lpx/BoxJs.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
BoxJs-request = type=http-request, pattern="(?i)(?:^https?://(.+\\.)?boxjs\\.(com|net))", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/BoxJs-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=120

[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
h2 = true
