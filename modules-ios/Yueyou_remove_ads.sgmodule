#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=阅友去广告 · Surge iOS
#!desc=移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Yueyou_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ads.reader.yueyouxs.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https://goway\.reader\.yueyouxs\.com/assemble/app/basic/getAppInfo\? '(. as $__original | try del(.data.isShowDLPopup) catch $__original) | (. as $__original | try del(.data.isShowGame) catch $__original) | (. as $__original | try del(.data.touTiaoShowDlPopup) catch $__original) | (. as $__original | try del(.data.offLineDownload.WatchVideoBtnDesc) catch $__original) | (. as $__original | try del(.data.readVipFirstCfg) catch $__original) | (. as $__original | try del(.data.readVipNormalCfg) catch $__original) | (. as $__original | try del(.data.notifyAd) catch $__original) | (. as $__original | try del(.data.hotStartSplashTime) catch $__original) | (. as $__original | try del(.data.hotStartReqSwitch) catch $__original) | (. as $__original | try del(.data.isShowBFTab) catch $__original) | (. as $__original | try del(.data.popReqDelayTime) catch $__original) | (. as $__original | try del(.data.benefitCfg) catch $__original) | (. as $__original | try del(.data.chestTask) catch $__original) | (. as $__original | try del(.data.hotStartAd) catch $__original) | (. as $__original | try del(.data.activeTagList) catch $__original) | (. as $__original | try del(.data.secondOrderCfg) catch $__original) | (. as $__original | try del(.data.secondOrderList) catch $__original) | (. as $__original | try del(.data.blockedWordsCfg) catch $__original) | (. as $__original | try del(.data.aaReportListCfg) catch $__original) | (. as $__original | try del(.data.pddAdSwitch) catch $__original) | (. as $__original | try del(.data.isShowShelfAuthPopup) catch $__original) | (. as $__original | try del(.data.firstPopUpAmount) catch $__original)'
http-response-jq (?i)^https://goway\.reader\.yueyouxs\.com/assemble/app/basic/getAppInfo\? '.data.isAdClosed = true'

[MITM]
hostname = %APPEND% goway.reader.yueyouxs.com
h2 = true
