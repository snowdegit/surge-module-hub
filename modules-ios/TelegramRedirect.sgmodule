#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=Telegram重定向 · Surge iOS
#!desc=适用于安装了多个不同Telegram客户端的用户，用于在指定客户端中打开公开或私有群组及频道的Telegram短链。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/TelegramRedirect.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
TelegramRedirect-request = type=http-request, pattern="(?i)(?:^https://t\\.me/([A-Za-z][A-Za-z0-9_]{3,30}[A-Za-z0-9])/?$)|(?:^https://t\\.me/\\+([A-Za-z0-9_-]+)/?$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/TelegramRedirect-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10, argument="{\"app\":\"tg\"}"

[MITM]
hostname = %APPEND% t.me
h2 = true
