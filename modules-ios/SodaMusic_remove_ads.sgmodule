#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=汽水音乐去广告 · Surge iOS
#!desc=移除开屏广告、弹窗广告、播放器推广、歌曲详情界面视频推广、播放页面的歌曲视频，精简首页和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/SodaMusic_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com/get_domains/v\d/\? '.data.opaque_data_enabled = 0 | .data.ttnet_http_dns_enabled = 0 | .data.ttnet_quic_enabled = 0 | .data.ttnet_tt_http_dns = 0'
http-response-jq (?i)^https://tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com/get_domains/v\d/\? '.data.ttnet_dispatch_actions |= map(select(.action != "dispatch" and .action != "tc"))'
http-response-jq (?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/me\? '(. as $__original | try del(.reward_ad_banner) catch $__original)'
http-response-jq (?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/feed/song-tab\? 'del(.items[] | select(.type == "video_track_mix"))'
http-response-jq (?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/card\? '(. as $__original | try del(.preview_guide) catch $__original)'
http-response-jq (?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/card\? 'del(.card_items[] | select(has("priority_display")))'
http-response-jq (?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/more-panel\? '.blocks |= map(select(.type != "related_video"))'

[Map Local]
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/commerce/upsells_config\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(api|api5-lq)\.qishui\.com/luna/ads/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/ads/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://webcast-open\.douyin\.com/webcast/openapi/feed/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/treasure/entrance/config\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/activities\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/media_ads\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/commerce/upsells\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/commerce/v2/commerce_info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(beta-luna\.douyin|api5-lq\.qishui)\.com/luna/listen-video/reminder\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
SodaMusic_remove_ads-response = type=http-response, pattern="(?i)(?:^https://(beta-luna\\.douyin|api5-lq\\.qishui)\\.com/luna/me/recently-played-media\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/SodaMusic_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% webcast-open.douyin.com, beta-luna.douyin.com, api.qishui.com, api5-lq.qishui.com, tnc*-*.zijieapi.com
h2 = true
