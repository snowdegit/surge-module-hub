#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=WakeUp课程表去广告 · Surge iOS
#!desc=移除横幅广告、弹窗广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/WakeupSchedule_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.wakeup\.fun/wakeup/user/mine$ '(. as $__original | try del(.data.bannerItems) catch $__original)'

[Map Local]
(?i)^https://api\.wakeup\.fun/wakeup/app/bannerconf$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.wakeup.fun
h2 = true
