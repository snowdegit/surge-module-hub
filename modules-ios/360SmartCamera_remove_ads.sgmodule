#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=360摄像机去广告 · Surge iOS
#!desc=移除开屏广告、首页推广、底栏商城入口及我的页面推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/360SmartCamera_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ad.jia.360.cn, REJECT
DOMAIN, ad.iot.360.cn, REJECT

[Body Rewrite]
http-response-jq (?i)^https://jia\.360\.cn/conf/v1\.json '(. as $__original | try del(.tab_conf) catch $__original) | (. as $__original | try del(.ad_conf) catch $__original) | (. as $__original | try del(.activity) catch $__original)'

[MITM]
hostname = %APPEND% jia.360.cn
h2 = true
