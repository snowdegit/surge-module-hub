[Map Local]
(?i)^https://appapi\.motianlun\.cn/showapi/pub/site/\d+/app/loading\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appapi\.motianlun\.cn/showapi/pub/site/\d+/banner/app\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appapi\.motianlun\.cn/userdataapi/pub/v\d/top/keywords\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appapi\.motianlun\.cn/buyerapi/buyer/v\d/search/index\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appapi\.motianlun\.cn/showapi/site/\d+/transfer/recentShows\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% appapi.motianlun.cn
h2 = true
