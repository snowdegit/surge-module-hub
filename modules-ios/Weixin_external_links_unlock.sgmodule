#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=微信外部链接解锁 · Surge iOS
#!desc=解锁微信外部链接访问限制，跳过中间界面。支付宝链接、被封禁链接进行通知弹窗跳转，在微信中用快照显示被封禁的链接（可选），在微信中进行强制重定向（可选），群聊及扫码均可使用，可选项可在脚本的2~3行更改，也可在BoxJs中更改。
#!author=zZPiglet[https://github.com/zZPiglet]
# Source: https://kelee.one/Tool/Loon/Lpx/Weixin_external_links_unlock.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
Weixin_external_links_unlock-response = type=http-response, pattern="(?i)(?:^https\\://(weixin110\\.qq|security.wechat)\\.com/cgi-bin/mmspamsupport-bin/newredirectconfirmcgi\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Weixin_external_links_unlock-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% weixin110.qq.com, security.wechat.com
h2 = true
