#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=Sub-Store · Surge iOS
#!desc=高级订阅管理工具，定时任务默认为每天23点55分，可在插件设置中自定义。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
# Source: https://kelee.one/Tool/Loon/Lpx/Sub-Store.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, sub-store.vercel.app, PROXY

[Script]
Sub-Store-request = type=http-request, pattern="(?i)(?:^https?://sub\\.store/((download)|api/(preview|sync|(utils/node-info))))|(?:^https?://sub\\.store)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Sub-Store-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=120, argument="{\"cron\":\"55 23 * * *\"}"
Sub-Store-task-1 = type=cron, script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Sub-Store-task-1.js?v=20261115.2, timeout=120, cronexp="55 23 * * *", argument="{\"cron\":\"55 23 * * *\"}"

[MITM]
hostname = %APPEND% sub.store
h2 = true
