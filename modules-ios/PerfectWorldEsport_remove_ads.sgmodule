#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=完美世界电竞去广告 · Surge iOS
#!desc=移除开屏广告，精简搜索页。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/PerfectWorldEsport_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.wmpvp\.com/api/v1/config/promote$ '(. as $__original | try del(.data.ad) catch $__original)'

[Map Local]
(?i)^https://appactivity\.wmpvp\.com/hotsearch/all\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.wmpvp.com, appactivity.wmpvp.com
h2 = true
