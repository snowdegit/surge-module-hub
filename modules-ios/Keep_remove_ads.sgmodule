#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=Keep去广告 · Surge iOS
#!desc=移除开屏广告、搜索推荐和弹窗广告，精简底栏和首页标签。移除关注推荐、文章相关推荐和信息流中的课程推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Keep_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, kad.gotokeep.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https://api\.gotokeep\.com/op-engine-webapp/v1/configs$ '(. as $__original | try del(.data.adTimeoutReport) catch $__original) | (. as $__original | try del(.data.spotShowReport) catch $__original) | (. as $__original | try del(.data.adSupplementIntervalMinutes) catch $__original) | (. as $__original | try del(.data.adSupplementSwitch) catch $__original) | (. as $__original | try del(.data.hotFeedSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.activityBrandFeedSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.searchFeedSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.feedDetailSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.homePageFeedSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.followFeedSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.hotFeedRecommendSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.activityFeedSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.hotFeedFindSpotAdRequestMoment) catch $__original) | (. as $__original | try del(.data.hotFeedSpotFixedPositionSecond) catch $__original) | (. as $__original | try del(.data.searchFeedSpotFixedPositionSecond) catch $__original) | (. as $__original | try del(.data.followFeedSpotFixedPositionSecond) catch $__original) | (. as $__original | try del(.data.activityFeedSpotFixedPositionSecond) catch $__original) | (. as $__original | try del(.data.searchFeedSpotFixedPositionThird) catch $__original) | (. as $__original | try del(.data.hotFeedFindSpotFixedPositionSecond) catch $__original) | (. as $__original | try del(.data.hotFeedFindSpotFixedPositionThird) catch $__original) | (. as $__original | try del(.data.activityFeedSpotFixedPositionInitial) catch $__original) | (. as $__original | try del(.data.activityFeedSpotFixedPositionThird) catch $__original) | (. as $__original | try del(.data.hotFeedDynamicSpotPosition) catch $__original) | (. as $__original | try del(.data.feedDetailDynamicSpotPosition) catch $__original) | (. as $__original | try del(.data.hotFeedRecommendDynamicSpotPosition) catch $__original) | (. as $__original | try del(.data.hotFeedFindDynamicSpotPosition) catch $__original) | (. as $__original | try del(.data.homePageFeedDynamicSpotPosition) catch $__original) | (. as $__original | try del(.data.followFeedDynamicSpotPosition) catch $__original) | (. as $__original | try del(.data.searchFeedSpotPositionDynamic) catch $__original) | (. as $__original | try del(.data.activityFeedSpotPositionDynamic) catch $__original) | (. as $__original | try del(.data.activityBrandFeedSpotPositionDynamic) catch $__original) | (. as $__original | try del(.data.splashAdLoadTimeLimit) catch $__original) | (. as $__original | try del(.data.courseAdLoadTimeLimit) catch $__original) | (. as $__original | try del(.data.feedAdLoadTimeLimit) catch $__original) | (. as $__original | try del(.data.aliHCSpotConfig) catch $__original) | (. as $__original | try del(.data.gdtSpotConfig) catch $__original) | (. as $__original | try del(.data.pugcThresholdPercent) catch $__original) | (. as $__original | try del(.data.pugcStepMinSeconds) catch $__original) | (. as $__original | try del(.data.pugcStepMaxSeconds) catch $__original) | (. as $__original | try del(.data.pugcPreLoadEarlySeconds) catch $__original) | (. as $__original | try del(.data.pugcLoadPostPreRolls) catch $__original) | (. as $__original | try del(.data.closeConfirmButtonText) catch $__original)'
http-response-jq (?i)^https://api\.gotokeep\.com/twins/union/feed/union_feed_all$ '.data.modules |= map(select(.code == "unionFeedEntry"))'
http-response-jq (?i)^https://api\.gotokeep\.com/twins/v4/feed/entryDetail\? '.data = "{}"'
http-response-jq (?i)^https://api\.gotokeep\.com/config/v3/basic\? '.data.bottomBarControl.tabs |= map(select(.tabType | . == "home" or . == "schedule" or . == "dynamic_sports" or . == "personal")) | .data.homeTabs |= map(select(.type | . == "socialTab" or . == "union_feed_all" or . == "homeRecommend" or . == "suitTab" or . == "union_feed_route"))'
http-response-jq (?i)^https://api\.gotokeep\.com/pencil-webapp/play/v1/games\? '.data.games[].microGames[] |= if .leftIcon? and .leftIcon.type == "aiMode" then del(.leftIcon) else . end'

[Map Local]
(?i)^https://api\.gotokeep\.com/op-engine-webapp/v1/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/search/v6/default/keyword/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/twins/v4/feed/followPage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/twins/union/feed/function\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/guide-webapp/v1/popup/getPopUp\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/search/v5/hotCourse/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/search/v4/hotHashtag/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.gotokeep\.com/search/v4/hotword/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.gotokeep.com
h2 = true
