#!requirement=SYSTEM = 'iOS'
# iOS build: explicit upstream defaults; no Mac-only argument table.
#!version=2026.11.15.3-ios
#!name=WPS每日签到 · Surge iOS
#!desc=WPS每日签到并兑换会员，需要进入此插件的主页链接，阅读使用说明操作。
#!author=小白脸
# Source: https://kelee.one/Tool/Loon/Lpx/WPS_checkin.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
WPS_checkin-request = type=http-request, pattern="(?i)(?:^https://moapi\\.wps\\.cn/app/ios/v1/app$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/WPS_checkin-request.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10, argument="{\"CaptureCookie\":\"false\",\"AK\":\"\",\"SK\":\"\",\"DAY\":\"1\",\"MAX_RETRIES\":\"5\",\"CRONEXP\":\"0 8 * * *\"}"
WPS_checkin-task-1 = type=cron, script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/WPS_checkin-task-1.js?v=20261115.2, timeout=120, cronexp="0 8 * * *", argument="{\"CaptureCookie\":\"false\",\"AK\":\"\",\"SK\":\"\",\"DAY\":\"1\",\"MAX_RETRIES\":\"5\",\"CRONEXP\":\"0 8 * * *\"}"

[MITM]
hostname = %APPEND% moapi.wps.cn
h2 = true
