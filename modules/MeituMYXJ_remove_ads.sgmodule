#!name=美颜相机去广告 · Surge
#!desc=移除开屏广告、应用内弹窗，精简首页和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/MeituMYXJ_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, adui.tg.meitu.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https://api\.meiyan\.com/operation/get_config\.json\? 'del(.response.time_limit,.response.bubble,.response.person_center)'
http-response-jq (?i)^https://api\.meiyan\.com/operation/get_config\.json\? '.response.function_pop.meiyan_style.is_pop = [false, 0, 0] | .response.onoff.vip_half_window_exit_remain_popup.open = [false, 0, 0] | .response.onoff.vip_home_exit_remain_popup = [false, 0, 0]'

[Map Local]
(?i)^https://api\.meiyan\.com/operation/home_banner\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.meiyan\.com/vip/permission_update_popup\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
MeituMYXJ_remove_ads-response = type=http-response, pattern=(?i)(?:^https://api\.meiyan\.com/operation/home\.json\?), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/MeituMYXJ_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.meiyan.com
h2 = true
