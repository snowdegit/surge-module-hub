#!name=美丽修行去广告 · Surge
#!desc=移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Meizhixiuxing_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/page$ 'del(.result.versionPopUp,.result.isShowSearchLabel,.result.isShowSearchFeedBack,.result.centerBannerAdvert,.result.programmaticAdvertising,.result.mattsData,.result.questionnaireMap,.result.appPullDownAdvert)'
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/feed$ 'del(.result.banners)'
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/feed$ '. | .result.returnList |= (map(select(.tname == "userPart"))) | .result.returnList |= map(select(. | has("adId") | not))'
http-response-jq (?i)^https://api\.bevol\.com/trialbox/shop/app/homePage$ 'del(.result.firstPersonActivity,.result.mainActivity,.result.brandZone,.result.imageAD2,.result.couponPopupInfo)'

[Map Local]
(?i)^https://api\.bevol\.com/appmain/app/home/launch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/appmain/app/home/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/personal/page$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/seach/foundAndTopSearch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.bevol.com
h2 = true
