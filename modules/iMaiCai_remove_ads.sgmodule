#!name=小象超市去广告 · Surge
#!desc=移除开屏广告、应用内弹窗、猜你想买、横幅推广和悬浮窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/iMaiCai_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://mall\.meituan\.com/api/c/homepage/splash data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mall\.meituan\.com/api/c/homepage/bubble/operate/info data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mall\.meituan\.com/api/c/jigsaw/code/category-banner-\d+/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mall\.meituan\.com/api/c/poi/\d+/order/recommend/v\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mall\.meituan\.com/api/c/banner/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mall\.meituan\.com/api/c/poi/\d+/personal/recommend data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://businessapi\.ksedt\.com/signupindex/jxlist data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
iMaiCai_remove_ads-response = type=http-response, pattern=(?i)(?:^https://portal-portm\.meituan\.com/horn_ios/mergeRequest), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/iMaiCai_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% portal-portm.meituan.com, mall.meituan.com, businessapi.ksedt.com
h2 = true
