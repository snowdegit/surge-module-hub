[Script]
1.1.1.1-request = type=http-request, pattern="(?i)(?:^https?://(api|zero-trust-client)\\.cloudflareclient\\.com/(.*)/reg/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$)|(?:^https?://(api|zero-trust-client)\\.cloudflareclient\\.com/(.*)/reg/t\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/1.1.1.1-request.js, requires-body=true, binary-body-mode=false, timeout=10
1.1.1.1-response = type=http-response, pattern="(?i)(?:^https?://(api|zero-trust-client)\\.cloudflareclient\\.com/(.*)/reg/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$)|(?:^https?://(api|zero-trust-client)\\.cloudflareclient\\.com/(.*)/reg/t\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/1.1.1.1-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.cloudflareclient.com, zero-trust-client.cloudflareclient.com
h2 = true
