[Map Local]
(?i)^https://idgdata\.baidu\.com/mc/app/api/listterminal\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://idgdata\.baidu\.com/operation/api/announce/screen/image_manage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://idgdata\.baidu\.com/idgactivity/api/newuser/info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% idgdata.baidu.com
h2 = true
