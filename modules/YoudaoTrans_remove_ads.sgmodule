(?i)^https://gorgon\.youdao\.com/gorgon/brand/prefetch\.s data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gorgon\.youdao\.com/gorgon/request\.s data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fanyiguan-server\.youdao\.com/server/banner\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
