#!name=小红书去广告 · Surge
#!desc=过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200]
# Source: https://kelee.one/Tool/Loon/Lpx/RedPaper_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, xiaohongshu.com)), REJECT

[Body Rewrite]
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v1/search/banner_list$ '.data = "{}"'
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v1/search/hot_list$ '.data.items = "[]"'
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v4/search/hint '.data.hint_words = "[]"'
http-response-jq (?i)^https://edith\.xiaohongshu\.com/api/sns/v4/search/trending\? '.data.queries = ["[]", "{}"] | .data.hint_word = ["[]", "{}"]'

[Map Local]
(?i)^https://ci\.xiaohongshu\.com/system_config/watermark data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"
(?i)^https://edith\.xiaohongshu\.com/api/sns/v1/surprisebox/(?:get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.xiaohongshu\.com/api/marketing/box/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://edith\.xiaohongshu\.com/api/sns/(?:v2/guide/user_banner|v3/note/guide) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.xiaohongshu\.com/api/sns/(?:v1/ads/resource|v2/hey/\w+/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
RedPaper_remove_ads-response = type=http-response, pattern=(?i)(?:^https://edith\.xiaohongshu\.com/api/sns/v1/note/(?:imagefeed|live_photo/save))|(?:^https://edith\.xiaohongshu\.com/api/sns/v1/system/service/ui/config\?)|(?:^https://edith\.xiaohongshu\.com/api/sns/v1/system_service/config\?)|(?:^https://edith\.xiaohongshu\.com/api/sns/v2/system_service/splash_config)|(?:^https://edith\.xiaohongshu\.com/api/sns/v2/(?:note/widgets|user/followings/followfeed))|(?:^https://edith\.xiaohongshu\.com/api/sns/v4/followfeed\?)|(?:^https://edith\.xiaohongshu\.com/api/sns/v5/recommend/user/follow_recommend\?)|(?:^https://edith\.xiaohongshu\.com/api/sns/(?:v1/interaction/comment/video/download|v5/note/comment/list))|(?:^https://edith\.xiaohongshu\.com/api/sns/(?:v2/note/feed|v3/note/videofeed))|(?:^https://(?:edith|rec)\.xiaohongshu\.com/api/sns/v6/homefeed\?)|(?:^https://(?:edith|so)\.xiaohongshu\.com/api/sns/v10/search/notes\?)|(?:^https://(?:edith|rec|www)\.xiaohongshu\.com/api/sns/(?:v4/note/videofeed|v10/note/video/save)), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/RedPaper_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
h2 = true
