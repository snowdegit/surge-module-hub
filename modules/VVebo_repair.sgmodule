#!version=2026.11.15.2
#!name=VVebo时间线修复 · Surge
#!desc=修复失效的用户时间线和我的页面。使用此插件前需要禁用微博去广告插件，避免插件冲突导致失效。
#!author=suiyuran[https://github.com/suiyuran], androidcn[https://github.com/androidcn]
# Source: https://kelee.one/Tool/Loon/Lpx/VVebo_repair.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
VVebo_repair-request = type=http-request, pattern="(?i)(?:^https://api\\.weibo\\.cn/2/users/show\\?)|(?:^https://api\\.weibo\\.cn/2/statuses/user_timeline\\?)|(?:^https://api\\.weibo\\.cn/2/remind/unread_count\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/VVebo_repair-request.js, requires-body=false, binary-body-mode=false, timeout=10
VVebo_repair-response = type=http-response, pattern="(?i)(?:^https://api\\.weibo\\.cn/2/profile/statuses/tab\\?)|(?:^https://api\\.weibo\\.cn/2/cardlist\\?)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/VVebo_repair-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.weibo.cn
h2 = true
