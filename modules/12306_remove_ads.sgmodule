#!version=2026.11.15.2
#!name=12306去广告 · Surge
#!desc=过滤12306应用内广告及开屏广告
#!author=RuCu6[https://github.com/RuCu6], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/12306_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ad.12306.cn, DIRECT

[Body Rewrite]
http-response-jq (?i)^https://ad\.12306\.cn/ad/ser/getAdList$ '(. as $__original | try del(.materialsList) catch $__original) | (. as $__original | try del(.advertParam) catch $__original)'

[Script]
12306_remove_ads-request = type=http-request, pattern="(?i)(?:^https://mobile\\.12306\\.cn/otsmobile/app/mgs/mgw\\.htm$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/12306_remove_ads-request.js, requires-body=false, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn
h2 = true
