#!name=小米音箱去广告 · Surge
#!desc=移除开屏广告、应用内横幅广告及弹窗广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/XiaomiSpeaker_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://marketing-aibox\.v\.mitvos\.com/advertise/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://marketing-aibox\.v\.mitvos\.com/payGuide/halfScreenMulti/(home|cache)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://marketing-aibox\.v\.mitvos\.com/payGuide/tabPage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% marketing-aibox.v.mitvos.com
h2 = true
