#!name=中国移动云盘去广告 · Surge
#!desc=移除中国移动云盘开屏广告及应用内广告，首页的多余卡片可滑到最底部自定义隐藏掉，插件对此不做处理。
#!author=RuCu6[https://github.com/RuCu6]
# Source: https://kelee.one/Tool/Loon/Lpx/mobileClouds_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
mobileClouds_remove_ads-response = type=http-response, pattern=(?i)(?:^https://jzts\.cmpassport\.com/personalized/getPushContent)|(?:^https://ad\.mcloud\.139\.com/advertapi/adv-filter/), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/mobileClouds_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% jzts.cmpassport.com, ad.mcloud.139.com
h2 = true
