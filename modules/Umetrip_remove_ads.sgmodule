# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
URL-REGEX, "^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native", REJECT

[Script]
Umetrip_remove_ads-response = type=http-response, pattern="(?i)(?:^http?://(114\\.115\\.217\\.129)|(home\\.umetrip\\.com)/gateway/api/umetrip/native$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Umetrip_remove_ads-response.js?v=20261115.2, requires-body=false, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% 114.115.217.129, home.umetrip.com
h2 = true
