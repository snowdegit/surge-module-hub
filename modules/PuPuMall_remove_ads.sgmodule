# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://j1\.pupuapi\.com/client/account/discount/order data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://j1\.pupuapi\.com/client/marketing/banner/v7\?position_types=100 data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
PuPuMall_remove_ads-response = type=http-response, pattern="(?i)(?:^https://j1\\.pupuapi\\.com/client/marketing/banner/v7)|(?:^https://j1\\.pupuapi\\.com/client/marketing/banner/search_component_banner)|(?:^https://j1\\.pupuapi\\.com/client/search/hot_keywords/v3)|(?:^https://j1\\.pupuapi\\.com/client/app_resource/resource_preload/list_h5_resource)|(?:^https://j1\\.pupuapi\\.com/client/recommendation/interests/products)|(?:^https://j1\\.pupuapi\\.com/client/marketing/advertisement/v1)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/PuPuMall_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% j1.pupuapi.com
h2 = true
