#!name=医考帮去广告 · Surge
#!desc=移除横幅推广、弹窗、首页悬浮挂件。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/YiKaoBang_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://api\.yikaobang\.com\.cn/index\.php/client/main/ads\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.yikaobang\.com\.cn/index\.php/client/Main/startPage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.yikaobang.com.cn
h2 = true
