#!version=2026.11.15.2
#!name=Spotify去广告 · Surge
#!desc=移除播放广告，恢复歌手和专辑列表的正常展示。修改插件自定义配置项需要重新登陆方可生效。
#!author=001ProMax[https://github.com/001ProMax]
# Source: https://kelee.one/Tool/Loon/Lpx/Spotify_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.
#!arguments=tab:false,useractivity:true
#!arguments-desc=参数沿用上游默认值；修改后重新启用模块。

[Rule]
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT

[Map Local]
(?i)^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/pendragon/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
Spotify_remove_ads-request = type=http-request, pattern="(?i)(?:^https://(?:\\w+-spclient|spclient\\.wg)\\.spotify\\.com(?::443)?/artistview/v1/artist/(.*)&platform=iphone)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Spotify_remove_ads-request.js?v=20261115.2, requires-body=false, binary-body-mode=false, timeout=10, argument="{\"tab\":\"{{{tab}}}\",\"useractivity\":\"{{{useractivity}}}\"}"
Spotify_remove_ads-response = type=http-response, pattern="(?i)(?:^https://(?:\\w+-spclient|spclient\\.wg)\\.spotify\\.com(?::443)?/(?:bootstrap|user-customization-service))", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Spotify_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10, argument="{\"tab\":\"{{{tab}}}\",\"useractivity\":\"{{{useractivity}}}\"}"

[MITM]
hostname = %APPEND% *-spclient.spotify.com, spclient.wg.spotify.com
h2 = true
