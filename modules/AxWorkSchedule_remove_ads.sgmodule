[Map Local]
(?i)^https://schedule-api\.julanling\.com/api\d/get_splash$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://schedule-api\.julanling\.com/api\d/index_advert$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://schedule-api\.julanling\.com/api\d/queryAdvertConfig$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% schedule-api.julanling.com
h2 = true
