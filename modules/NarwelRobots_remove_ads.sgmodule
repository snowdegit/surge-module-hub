#!version=2026.11.15.2
#!name=云鲸智能去广告 · Surge
#!desc=移除开屏广告、横幅推广，禁用商城。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/NarwelRobots_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://cn-app\.narwaltech\.com/operate/appPosition/listSplash\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cn-app\.narwaltech\.com/operate/cactivity/listByResourceIds\?resourceIds=(user_center_banner|index_banner) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://store\.narwal\.com/mall/customPage/getByPageKeyword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% cn-app.narwaltech.com, store.narwal.com
h2 = true
