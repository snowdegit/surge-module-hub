#!version=2026.11.15.2
#!name=一甜相机去广告 · Surge
#!desc=移除开屏广告、悬浮广告及图片选择器横幅广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Yitian_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://(m2u-api\.getkwai|api-m2u\.kuaishou)\.com/api-server/api/v1/system/configs\? '(. as $__original | try del(.data.shouldUseLMAdFirst) catch $__original) | (. as $__original | try del(.data.incentiveCfgList) catch $__original)'

[Map Local]
(?i)^https://(m2u-api\.getkwai|api-m2u\.kuaishou)\.com/api-server/api/v1/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(m2u-api\.getkwai|api-m2u\.kuaishou)\.com/api-server/api/v4/op/actPositions\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% m2u-api.getkwai.com, api-m2u.kuaishou.com
h2 = true
