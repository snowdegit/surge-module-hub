#!version=2026.11.15.2
#!name=挖财记账去广告 · Surge
#!desc=移除弹窗广告、推广语横幅和右下角悬浮广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/WaCaiJiZhang_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://jz\.wacaijizhang\.com/api/banners/ribbon\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://jz\.wacaijizhang\.com/api/banners/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://jz\.wacaijizhang\.com/api/resource/universal/fetch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% jz.wacaijizhang.com
h2 = true
