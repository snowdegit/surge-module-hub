[Body Rewrite]
http-response-jq (?i)^https://api\.cece\.com/user/init\? 'del(.data.launch_img_url,.data.launch_goto_url)'
http-response-jq (?i)^https://api\.cece\.com/common/app/app_config\? '.data.is_new_year = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.spring_festival = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_feedback_entry = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_course_entry = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_store_entry = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_luna = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_ead = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_ad = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.show_live_filter_tarot = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.community_feed_adswitch = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.open_screen_ad_times = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.open_screen_ad_duration = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.isShowThumbsGif = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.teenager_mode_open = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false] | .data.flu_log = [false, false, false, false, false, false, false, false, false, false, 0, 0, false, false, false]'
http-response-jq (?i)^https://api\.cece\.com/common/app/app_config\? 'del(.data.activity_list,.data.fortune_ab_config)'
http-response-jq (?i)^https://api\.cece\.com/chart/tools/home_10_tools\? '.data.tools |= map(del(.icon_tip_image))'
http-response-jq (?i)^https://api\.cece\.com/user/index/tab_list\? '.data.tabs |= map(select(.type != "shop"))'
http-response-jq (?i)^https://api\.cece\.com/common/app/risk_entrance\? '.data.ai_fortune_show_ask_tool = [false, false, false, false, false, false, false, false, false, false] | .data.ai_sign_show_ask_tool = [false, false, false, false, false, false, false, false, false, false] | .data.single_tool_show_dice_card = [false, false, false, false, false, false, false, false, false, false] | .data.single_tool_show_tarot_card = [false, false, false, false, false, false, false, false, false, false] | .data.single_tool_show_bazi_card = [false, false, false, false, false, false, false, false, false, false] | .data.single_tool_show_hepan_card = [false, false, false, false, false, false, false, false, false, false] | .data.single_tool_show_ziwei_card = [false, false, false, false, false, false, false, false, false, false] | .data.single_tool_show_xingpan_card = [false, false, false, false, false, false, false, false, false, false] | .data.multi_tool_show_card = [false, false, false, false, false, false, false, false, false, false] | .data.ai_ccai_show_multi_tool = [false, false, false, false, false, false, false, false, false, false]'

