#!name=大麦去广告 · Surge
#!desc=移除开屏广告、轮播图广告和弹窗广告，移除搜索填充词和专属推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Damai_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.user\.my\.content\.get/ 'del(.data.banner,.data.performFilmVip.userProfitList)'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.mypage\.feed/ 'del(.data.feedCard)'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.aristotle\.get/ 'del(.data.data.top.keywords)'

[Map Local]
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.home\.welcome/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.popup\.get/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% acs.m.taobao.com
h2 = true
