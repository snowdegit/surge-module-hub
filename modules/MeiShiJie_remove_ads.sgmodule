#!name=美食杰去广告 · Surge
#!desc=移除开屏广告和信息流广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/MeiShiJie_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://newapi\.meishi\.cc/indexnew/home_feeds 'if .data.items then .data.items |= map(select(.type | . != "101" and . != "12")) else . end'

[MITM]
hostname = %APPEND% newapi.meishi.cc
h2 = true
