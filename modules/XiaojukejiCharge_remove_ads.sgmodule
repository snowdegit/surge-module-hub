#!version=2026.11.15.2
#!name=小桔充电去广告 · Surge
#!desc=移除横幅广告、弹窗广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/XiaojukejiCharge_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://energy\.xiaojukeji\.com/am/marketing/api/member/facade/charge/personal/center\? '(. as $__original | try del(.data) catch $__original)'

[Map Local]
(?i)^https://energy\.xiaojukeji\.com/energy/hummer/api/resource/display($|\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://energy\.xiaojukeji\.com/lego/api/orderSprint/stair/info($|\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://energy\.xiaojukeji\.com/station-api/search/preWords$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://am\.didistatic\.com/static/am/cf-terminal/epower/epower-thanos-app/\d+\.\d+\.\d+/pages/people/index\.js$ data-type=file data="https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/data/807a08b4daff3797.txt" status-code=200 header="Content-Type:text/plain; charset=utf-8"

[MITM]
hostname = %APPEND% energy.xiaojukeji.com, am.didistatic.com
h2 = true
