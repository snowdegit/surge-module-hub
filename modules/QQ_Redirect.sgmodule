#!version=2026.11.15.2
#!name=QQ链接解锁 · Surge
#!desc=解除QQ内访问非白名单之外的地址提示停止访问该页面的限制，并移除跟踪参数，使用前需要清除QQ的缓存数据。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/QQ_Redirect.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
QQ_Redirect-request = type=http-request, pattern="(?i)(?:(^https://c\\.pc\\.qq\\.com/middlem\\.html\\?pfurl=)(http.*)(&pfuin=.*))|(?:(^https://c\\.pc\\.qq\\.com/middlect\\.html\\?pfuin=.*&pfurl=)(http.*)(&gjsublevel=.*))|(?:(^https://c\\.pc\\.qq\\.com/middlect\\.html\\?iscontinue=.*pfurl=)(http.*)(&pfuin=.*))|(?:(^https://pingtas\\.qq\\.com/webview/pingd\\?dm=c\\.pc\\.qq\\.com&pvi=\\d+&si=s\\d+&url=/middlem\\.html\\?pfurl%3d)(http.*)(%26pfuin%3d.*%26pfuin%3d.*))|(?:(^https://cgi\\.connect\\.qq\\.com/qqconnectopen/get_urlinfoForQQV2\\?url=)(http.*))|(?:(^https://c\\.pc\\.qq\\.com/index\\.html\\?pfurl=)(http.*)(&pfuin=.*))|(?:(^https://c\\.pc\\.qq\\.com/ios\\.html\\?url=)(http.*)(&level=.*))|(?:(^https://pingtas\\.qq\\.com/webview/pingd\\?dm=c\\.pc\\.qq\\.com&pvi=\\d+&si=s\\d+&url=/ios\\.html\\?url%3d)(http.*)(%26level.*%26level.*))", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/QQ_Redirect-request.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% pingtas.qq.com, c.pc.qq.com, cgi.connect.qq.com
h2 = true
