#!version=2026.11.15.2
#!name=Spotify歌词增强 · Surge
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。
#!author=VirgilClyne[https://github.com/VirgilClyne]
# Source: https://kelee.one/Tool/Loon/Lpx/Spotify_lyrics_translation.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Script]
Spotify_lyrics_translation-request = type=http-request, pattern="(?i)(?:^https?://spclient\\.wg\\.spotify\\.com/color-lyrics/v2/track/(.+)\\?(.*)format=json)|(?:^https?://spclient\\.wg\\.spotify\\.com/color-lyrics/v2/track/\\w+\\?(.*))", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Spotify_lyrics_translation-request.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10
Spotify_lyrics_translation-response = type=http-response, pattern="(?i)(?:^https?://api\\.spotify\\.com/v1/tracks\\?)|(?:^https?://spclient\\.wg\\.spotify\\.com/color-lyrics/v2/track/(.+)\\?(.*)format=json(.*)subtype=Translate)|(?:^https?://spclient\\.wg\\.spotify\\.com/color-lyrics/v2/track/\\w+\\?(.*)subtype=Translate)|(?:^https?://spclient\\.wg\\.spotify\\.com/color-lyrics/v2/track/(.+)\\?(.*)format=json(.*)subtype=External)|(?:^https?://spclient\\.wg\\.spotify\\.com/color-lyrics/v2/track/\\w+\\?(.*)subtype=External)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Spotify_lyrics_translation-response.js?v=20261115.2, requires-body=true, binary-body-mode=true, timeout=10

[MITM]
hostname = %APPEND% api.spotify.com, spclient.wg.spotify.com
h2 = true
