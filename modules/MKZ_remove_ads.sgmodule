#!version=2026.11.15.2
#!name=漫客栈去广告 · Surge
#!desc=移除开屏广告、漫画广告、小说章末广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/MKZ_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://base\.mkzcdn\.com/advert/app/read/v\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://base\.mkzcdn\.com/advert/app/story/read/v\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://base\.mkzcdn\.com/advert/app/task/motivate/v\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://base\.mkzcdn\.com/advert/app/task/motivate/v\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://base\.mkzcdn\.com/advert/app/user/slide\d/v\d/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
MKZ_remove_ads-response = type=http-response, pattern="(?i)(?:^https://base\\.mkzcdn\\.com/app/config/)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/MKZ_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% base.mkzcdn.com
h2 = true
