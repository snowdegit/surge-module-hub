#!version=2026.11.15.2
#!name=百度地图去广告 · Surge
#!desc=移除开屏广告、出行页面推广、周边页面推广、打车页面推广，精简我的页面。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!author=可莉🅥[https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c]
# Source: https://kelee.one/Tool/Loon/Lpx/BaiduMap_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://newclient\.map\.baidu\.com/feed/govui/rich_content '(. as $__original | try del(.data) catch $__original)'
http-response-jq (?i)^https://newclient\.map\.baidu\.com/client/noticebar/get\? '(. as $__original | try del(.content.multi_data) catch $__original)'
http-response-jq (?i)^https://newclient\.map\.baidu\.com/(client/)?usersystem/mine/page\? '.data = "{}"'
http-response-jq (?i)^https://newclient\.map\.baidu\.com/client/phpui2/\?qt=ads&type=user_home_new_service '(. as $__original | try del(.ads) catch $__original)'
http-response-jq (?i)^https://newclient\.map\.baidu\.com/living/nearby/api\? '(. as $__original | try del(.Result.cards[1]) catch $__original) | (. as $__original | try del(.Result.cards[4]) catch $__original) | (. as $__original | try del(.Result.cards[5]) catch $__original) | (. as $__original | try del(.Result.cards[9]) catch $__original)'

[Map Local]
(?i)^https://afd\.baidu\.com/afd/entry\?action=(update|query) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yongche\.baidu\.com/gomarketing/api/popup/getentrancecordovaurl$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yongche\.baidu\.com/goorder/passenger/cobuild/pull\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yongche\.baidu\.com/goorder/passenger/operationgirdle$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yongche\.baidu\.com/goorder/passenger/baseinfo$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ecom\.map\.baidu\.com/ad-ops/afd/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://maphotel\.baidu\.com/hotel/goextranet/activity/detail\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% afd.baidu.com, newclient.map.baidu.com, yongche.baidu.com, ecom.map.baidu.com
h2 = true
