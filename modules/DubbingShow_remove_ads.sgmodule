#!name=配音秀去广告 · Surge
#!desc=移除开屏广告、弹窗、横幅、各类关注推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/DubbingShow_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/Api/live/LiveList 'del(.data.banners)'
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/api/live/FollowList 'del(.obj.data)'
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/Api/Friend/GetRecommendUsers 'del(.obj.data)'
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/api/Union/HomeData 'del(.obj.data)'

[Script]
DubbingShow_remove_ads-response = type=http-response, pattern=(?i)(?:^https://iosapi\.peiyinxiu\.com/Api/Film/GetConfigValue), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/DubbingShow_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% iosapi.peiyinxiu.com
h2 = true
