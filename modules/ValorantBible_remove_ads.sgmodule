[Map Local]
(?i)^https://app\.mval\.qq\.com/go/recommend/platflashbox\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.mval\.qq\.com/go/mlol_news/search/varcache_hotV\d\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.mval\.qq\.com/go/customize_search/article_rank_tab\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.mval.qq.com
h2 = true
