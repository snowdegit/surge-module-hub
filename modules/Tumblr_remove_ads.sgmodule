#!version=2026.11.15.2
#!name=Tumblr去广告 · Surge
#!desc=移除信息流广告
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Tumblr_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api-http2\.tumblr\.com/v2/config$ '(. as $__original | try del(.response.ad_placement_configuration) catch $__original) | (. as $__original | try del(.response.configuration.fan_placement_id) catch $__original) | (. as $__original | try del(.response.configuration.display_io_max_ad_count) catch $__original) | (. as $__original | try del(.response.configuration.display_io_max_ad_loading_count) catch $__original) | (. as $__original | try del(.response.configuration.display_io_placement_id) catch $__original) | (. as $__original | try del(.response.configuration.display_io_test_placement_id) catch $__original) | (. as $__original | try del(.response.configuration.display_io_interscroller_display_test_placement_id) catch $__original) | (. as $__original | try del(.response.configuration.display_io_interscroller_video_test_placement_id) catch $__original) | (. as $__original | try del(.response.configuration.dfp_ad_unit_id) catch $__original) | (. as $__original | try del(.response.configuration.adx_total_queue_size) catch $__original) | (. as $__original | try del(.response.configuration.adx_loading_queue_size) catch $__original) | (. as $__original | try del(.response.configuration.fan_total_queue_size) catch $__original) | (. as $__original | try del(.response.configuration.fan_loading_queue_size) catch $__original) | (. as $__original | try del(.response.configuration.yahoo_total_queue_size) catch $__original) | (. as $__original | try del(.response.configuration.yahoo_loading_queue_size) catch $__original) | (. as $__original | try del(.response.configuration.min_minutes_between_sponsored_moments) catch $__original) | (. as $__original | try del(.response.configuration.rewarded_ad_timeout_seconds) catch $__original) | (. as $__original | try del(.response.configuration.vungle_ad_token_sync_seconds) catch $__original) | (. as $__original | try del(.response.configuration.static_interstitial_close_button_delay_seconds) catch $__original) | (. as $__original | try del(.response.configuration.video_interstitial_close_button_delay_seconds) catch $__original) | (. as $__original | try del(.response.configuration.static_interstitial_bid_floor_usd) catch $__original) | (. as $__original | try del(.response.configuration.video_interstitial_bid_floor_usd) catch $__original)'

[MITM]
hostname = %APPEND% api-http2.tumblr.com
h2 = true
