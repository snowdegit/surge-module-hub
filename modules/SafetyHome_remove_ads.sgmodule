#!version=2026.11.15.2
#!name=360智慧生活去广告 · Surge
#!desc=移除开屏广告、首页推广横幅、商城入口及我的页面推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/SafetyHome_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ad.iot.360.cn, REJECT

[Map Local]
(?i)^https://app\.home\.360\.cn/v1/config/custom_config data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.home.360.cn
h2 = true
