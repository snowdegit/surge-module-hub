#!name=剑网三无界去广告 · Surge
#!desc=移除热门推送活动，并解决无法在Loon运行时更新和登录的问题。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/SeasunJX3_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[General]
always-real-ip = %APPEND% *-update.xoyocdn.com, xg-flow.xoyo.com

[Map Local]
(?i)^https://jx3comm\.xoyocdn\.com/jx3gc/zhcn/login_ad/WebCareer/WebCareerTab\.txt data-type=text data="" status-code=404 header="Content-Type:text/plain"

[MITM]
hostname = %APPEND% jx3comm.xoyocdn.com
h2 = true
