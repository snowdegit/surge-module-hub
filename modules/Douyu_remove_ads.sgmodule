#!version=2026.11.15.2
#!name=斗鱼去广告 · Surge
#!desc=移除开屏、首页视频流、首页轮播图广告，移除直播间悬浮窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/Douyu_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
URL-REGEX, "^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list", REJECT
AND, ((DEST-PORT, 18000), (PROTOCOL, STUN)), REJECT
DOMAIN, stun1.douyucdn.cn, REJECT
DOMAIN, stun1.qvb.qcloud.com, REJECT

[URL Rewrite]
^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) $1$5$6 307

[Body Rewrite]
http-response-jq (?i)^https://apiv2\.douyucdn\.cn/japi/entrance/roomRes/nc/m/list '(. as $__original | try del(.data.pendant_a) catch $__original) | (. as $__original | try del(.data.entrance_d) catch $__original)'
http-response-jq (?i)^https://venus\.douyucdn\.cn/venus/config/static/update.+keyCodeSet=flow_config '.greatGodGameSitterSwitch = 0 | .followMoreAnchorEntrance = 0 | .sdklivebanner = 0 | .homeActFloatSwitch = 0 | .bringGoodsSwitch = 0 | .qqGameSwitch = 0'

[Map Local]
(?i)^https://rtbapi\.douyucdn\.cn/japi/sign/app/getinfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
Douyu_remove_ads-response = type=http-response, pattern="(?i)(?:^https://apiv2\\.douyucdn\\.cn/mgapi/livenc/home/getRecV3)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Douyu_remove_ads-response.js?v=20261115.2, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn
h2 = true
