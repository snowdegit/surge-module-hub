#!name=飞客去广告 · Surge
#!desc=移除开屏广告、首页广告、板块广告、帖内广告和我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/FlyerTea_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=advis data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=vip_coupon data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ptf\.flyertrip\.com/static/img/common/ic_plate_mine_button\.png data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"
(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=getdata data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
FlyerTea_remove_ads-response = type=http-response, pattern=(?i)(?:^https://www\.flyert\.com\.cn/api/mobile/index\.php\?version=5)|(?:^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=plugin&id=k_misign:sign), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/FlyerTea_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% www.flyert.com.cn, ptf.flyertrip.com
h2 = true
