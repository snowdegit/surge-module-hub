#!name=美柚去广告 · Surge
#!desc=移除开屏广告、弹窗推广和信息流推广，移除青少年模式弹窗和我的页面推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/MeetYou_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, ad.seeyouyima.com, REJECT
DOMAIN, axxd.xmseeyouyima.com, REJECT

[Body Rewrite]
http-response-jq (?i)^https://common\.seeyouyima\.com/v2/conf_list$ 'del(.data.confList.Minor_mode_card)'

[Map Local]
(?i)^https://circle\.(xm)?seeyouyima\.com/v\d/article_recommend\? data-type=text data="" status-code=404 header="Content-Type:text/plain"

[MITM]
hostname = %APPEND% circle.seeyouyima.com, circle.xmseeyouyima.com, common.seeyouyima.com
h2 = true
