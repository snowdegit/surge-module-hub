#!version=2026.11.15.2
#!name=图怪兽去广告 · Surge
#!desc=移除开屏广告、弹窗广告、各页面横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/TuGuaiShou_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://api\.818ps\.com/v4/advertisement/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.818ps\.com/v4/popup/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.818ps\.com/v4/festival/newYear/pop\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.818ps.com
h2 = true
