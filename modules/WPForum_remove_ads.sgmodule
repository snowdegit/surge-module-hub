#!version=2026.11.15.2
#!name=威锋去广告 · Surge
#!desc=移除开屏广告、信息流广告、文末广告、首页轮播图推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/WPForum_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://api\.wfdata\.club/v2/yesfeng/slideshow\? '.data |= map(select(.protocolId == 1))'

[Map Local]
(?i)^https://api\.wfdata\.club/v2/yesfeng/yesList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.wfdata.club
h2 = true
