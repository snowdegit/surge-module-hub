#!name=最美壁纸去广告 · Surge
#!desc=移除悬浮广告、横幅广告、轮播图广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/iWallBiZhi_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://api\.fzxhmy\.com/seek/trendingword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.fzxhmy\.com/tone/trending\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
iWallBiZhi_remove_ads-response = type=http-response, pattern=(?i)(?:^https://api\.fzxhmy\.com/core/initialize\?)|(?:^https://api\.fzxhmy\.com/landing/initialize\?)|(?:^https://api\.fzxhmy\.com/avatar/landing\?), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/iWallBiZhi_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% api.fzxhmy.com
h2 = true
