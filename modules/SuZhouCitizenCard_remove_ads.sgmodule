[Map Local]
(?i)^https?://newapp2\.szsmk\.com/app/config/queryMainAd data-type=text data="{\"message\":\"操作成功\",\"main_ad_list\":[],\"code\":\"000000\"}" status-code=200 header="Content-Type:application/json"
(?i)^https?://newapp2\.szsmk\.com/app/config/(queryCarousel|queryRecommendation)/ data-type=text data="{\"code\":\"000000\",\"message\":\"操作成功\",\"list\":[]}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% newapp2.szsmk.com
h2 = true
