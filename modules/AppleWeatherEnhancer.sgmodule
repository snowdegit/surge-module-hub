#!name=Apple天气增强 · Surge
#!desc=解锁Apple天气的全部功能、替换空气质量数据源、添加下一小时降水数据、添加天气数据。
#!author=VirgilClyne[https://github.com/VirgilClyne], WordlessEcho[https://github.com/WordlessEcho], 001[https://github.com/001ProMax]
# Source: https://kelee.one/Tool/Loon/Lpx/AppleWeatherEnhancer.lpx
# Generated port; device validation pending. See catalog compatibility notes.
#!arguments=Weather_Provider:ColorfulClouds,NextHour_Provider:ColorfulClouds,AirQuality_Calculate_Algorithm:EU_EAQI,API_ColorfulClouds_Token:,API_QWeather_Host:devapi.qweather.com,API_QWeather_Token:,API_WAQI_Token:,Storage:Argument,LogLevel:WARN
#!arguments-desc=参数沿用上游默认值；修改后重新启用模块。

[Rule]
DOMAIN, weather-analytics-events.apple.com, REJECT-DROP
DOMAIN, tether.edge.apple, REJECT-DROP
DOMAIN-SUFFIX, tthr.apple.com, REJECT-DROP
AND, ((OR, ((IP-ASN, 714, no-resolve), (IP-ASN, 6185, no-resolve))), (PROTOCOL, QUIC)), REJECT-DROP

[Script]
AppleWeatherEnhancer-response = type=http-response, pattern=(?i)(?:^https?://weatherkit\.apple\.com/api/v1/availability/)|(?:^https?://weatherkit\.apple\.com/api/v2/weather/), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/AppleWeatherEnhancer-response.js, requires-body=true, binary-body-mode=true, timeout=10, argument="{\"Weather.Provider\":\"{{{Weather_Provider}}}\",\"NextHour.Provider\":\"{{{NextHour_Provider}}}\",\"AirQuality.Calculate.Algorithm\":\"{{{AirQuality_Calculate_Algorithm}}}\",\"API.ColorfulClouds.Token\":\"{{{API_ColorfulClouds_Token}}}\",\"API.QWeather.Host\":\"{{{API_QWeather_Host}}}\",\"API.QWeather.Token\":\"{{{API_QWeather_Token}}}\",\"API.WAQI.Token\":\"{{{API_WAQI_Token}}}\",\"Storage\":\"{{{Storage}}}\",\"LogLevel\":\"{{{LogLevel}}}\"}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
h2 = true
