#!version=2026.11.15.2
#!name=书旗小说去广告 · Surge
#!desc=移除书城横幅广告、听书广告、阅读广告、章末推荐、福利入口、悬浮窗、推荐搜索词，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/ShuQiCenterReader_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
DOMAIN, render-web.11222.cn, REJECT

[Map Local]
(?i)^https://huichuan\.sm\.cn/nativead data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ocean\.shuqireader\.com/api/route/iosReadPage/adV2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ocean\.shuqireader\.com/api/route/ios/readPage$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ocean\.shuqireader\.com/api/render/load/resource data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
ShuQiCenterReader_remove_ads-response = type=http-response, pattern="(?i)(?:^https://ocean\\.shuqireader\\.com/sqios/render/render/page/bookstore$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/ShuQiCenterReader_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn
h2 = true
