#!name=快递100去广告 · Surge
#!desc=移除横幅广告、弹窗广告，精简首页。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/KuaiDi100_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https?://p\.kuaidi100\.com/mobile/mobileapi\.do$ 'del(.adsplash,.adIsConsumable,.adProductId,.nologin_tips,.index_banner,.me_banner,.index_banner_shadow,.adshongbao,.adsapp_homepage_ticket_pop,.adsoptimizationsend,.adsapp_activity_ad_array,.adbanner,.adposition,.adShowAgainTime)'
http-response-jq (?i)^https?://p\.kuaidi100\.com/apicenter/xcx\.dox 'del(.data.secondMenuList)'

[Map Local]
(?i)^https?://p\.kuaidi100\.com/advertisement/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://p\.kuaidi100\.com/e-commerce/act/actInfo\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://p\.kuaidi100\.com/apicenter/card\.dox data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% p.kuaidi100.com
h2 = true
