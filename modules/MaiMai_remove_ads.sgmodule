#!name=脉脉去广告 · Surge
#!desc=移除开屏广告、信息流广告、横幅推广、相关帖子推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/MaiMai_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://(h3\.)?open\.taou\.com/maimai/feed/v6/detail_recommend_feeds\? 'del(.feeds)'

[Map Local]
(?i)^https://(h3\.)?open\.taou\.com/maimai/adshow\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(h3\.)?open\.taou\.com/maimai/pay/v5/check_gift\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(h3\.)?open\.taou\.com/maimai/go_gossip_darwin/external/v2/query_flow_cards\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
MaiMai_remove_ads-response = type=http-response, pattern=(?i)(?:^https://(h3\.)?open\.taou\.com/maimai/(feed|gossip)/v\d/(focus_feed|gossip_detail_comment|feed_detail_comment?)\?), script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/MaiMai_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% open.taou.com, h3.open.taou.com
h2 = true
