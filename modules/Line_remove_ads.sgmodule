#!version=2026.11.15.2
#!name=Line去广告 · Surge
#!desc=移除Line各类广告
#!author=jkgtw[https://github.com/jkgtw]
# Source: https://kelee.one/Tool/Loon/Lpx/Line_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Rule]
URL-REGEX, "^https:\/\/a\.line\.me\/er\/lads\/v\d\/ei\?", REJECT-IMG
URL-REGEX, "^https:\/\/a\.line\.me\/er\/l.*\/v\d\/event\/image", REJECT-IMG
URL-REGEX, "^https:\/\/a\.line\.me\/lass\/api\/v\d\/ads$", REJECT-DROP
URL-REGEX, "^https:\/\/a\.line\.me\/oa\/v\d\/e$", REJECT-DROP
URL-REGEX, "^https:\/\/a\.line\.me\/cs\/v\d\/oa$", REJECT-DROP
URL-REGEX, "^https:\/\/w\.line\.me\/adp\/api\/ad\/v\d\/", REJECT-DROP
URL-REGEX, "^https:\/\/crs-event\.line\.me\/v\d\/imp", REJECT-DROP
URL-REGEX, "^https:\/\/sch\.line\.me\/api\/v\d\/ads$", REJECT-DROP
URL-REGEX, "^https:\/\/uts-front\.line-apps\.com\/event$", REJECT-DROP
URL-REGEX, "^https:\/\/uts-front\.line-apps\.com\/settings$", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0h[a-zA-Z0-9_-]{50}[a-zA-Z0-9_-]*", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0h.+\/(o|m)\d+x\d+$", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0hGH\d", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0h.+\/\d+p\.mp4$", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/r\/linecrs\/.+\/m180x180$", REJECT-IMG
URL-REGEX, "^https:\/\/ec-bot-obs\.line-scdn\.net\/0h[0-9a-zA-Z_-]{50}[0-9a-zA-Z_-]*", REJECT-IMG
URL-REGEX, "^https:\/\/d\.line-scdn\.net\/lcp-prod-photo\/20.+\.(jpg|jpeg|png)", REJECT-IMG
URL-REGEX, "^https:\/\/web-mmap-pay\.line-apps\.com\/tw\/liff\/campaign\/v\d\/aggregate\/ad\/banner\/", REJECT-IMG
URL-REGEX, "^https:\/\/scdn\.line-apps\.com\/lan\/image\/line\/bannerImageEvent\/", REJECT-DROP
URL-REGEX, "^https:\/\/scdn\.line-apps\.com\/lan\/document\/pageEvent\/line\/ios\/", REJECT-DROP

[Map Local]
(?i)^https://gw\.line\.naver\.jp/ext/lgfp/lad/v\d$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://gw\.line\.naver\.jp/lass/api/v\d/ads$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://gw\.line\.naver\.jp/tr/event$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://legy\.line-apps\.com:443/ext/lgfp/lad/v\d$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://legy\.line-apps\.com:443/ext/smartch/banner/sch/v\d$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://legy\.line-apps\.com/line\.gcs\.GcsModuleService/GetModulesByModuleIds$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://legy\.line-apps\.com:443/tr/event$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://lan\.line\.me/v\d/line/ios data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://buy\.line\.me/api/graphql\?variables data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://nelo2-col\.linecorp\.com/_store$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://cix\.line-apps\.com/R\d\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://ad\.line-scdn\.net/0h data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://static\.line-scdn\.net/ad-sdk/ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://scdn\.line-apps\.com/appresources/moretab/list\.json data-type=text data="" status-code=404 header="Content-Type:text/plain"

[MITM]
hostname = %APPEND% a.line.me, ad.line-scdn.net, w.line.me, gw.line.naver.jp, lan.line.me, buy.line.me, crs-event.line.me, obs.line-scdn.net, d.line-scdn.net, scdn.line-apps.com, sch.line.me, static.line-scdn.net, nelo2-col.linecorp.com, uts-front.line-apps.com, cix.line-apps.com, legy.line-apps.com, ec-bot-obs.line-scdn.net
h2 = true
