[Map Local]
(?i)^https://tianshu\.qq\.com/open/ts_access/GetAds\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://h5\.qzone\.qq\.com/p/adboss/api/json/ts_access/GetAds$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% tianshu.qq.com, h5.qzone.qq.com
h2 = true
