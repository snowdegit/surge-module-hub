#!name=百度翻译去广告 · Surge
#!desc=移除开屏广告、横幅广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/BaiduTranslate_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://fanyi-app\.baidu\.com/transapp/comment/my\? 'del(.data.taskBanner,.data.act)'
http-response-jq (?i)^https://fanyi-app\.baidu\.com/transapp/recitewd/myplan\? 'del(.data.activityRec,.data.activityRecList)'

[Map Local]
(?i)^https://fanyi-app\.baidu\.com/transapp/v2/api/launch/config\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fanyi-app\.baidu\.com/static/react-activity/page/courseBoutique\.html\? data-type=text data="" status-code=404 header="Content-Type:text/plain"

[MITM]
hostname = %APPEND% fanyi-app.baidu.com
h2 = true
