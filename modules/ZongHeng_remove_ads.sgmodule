#!name=纵横小说去广告 · Surge
#!desc=移除纵横小说开屏广告和弹窗
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/ZongHeng_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://api1\.zongheng\.com/iosapi/system/startup$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://api2\.zongheng\.com/api/giftBag/bindingBag$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api?.zongheng.com
h2 = true
