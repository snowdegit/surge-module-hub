#!version=2026.11.15.2
#!name=新浪财经去广告 · Surge
#!desc=移除开屏广告、弹窗广告、横幅广告、信息流广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/SinaStock_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Body Rewrite]
http-response-jq (?i)^https://news\.cj\.sina\.cn/app/v1/news724/list\? '(. as $__original | try del(.result.data.ad) catch $__original)'
http-response-jq (?i)^https://app\.cj\.sina\.com\.cn/apps/api/user/center\? '.result.data |= with_entries(select(.key == "button" or .key == "account" or .key == "balance"))'
http-response-jq (?i)^https://news\.cj\.sina\.cn/toutiao/content\? 'del(.result.data[]?.ad, .result.data[]?.report)'
http-response-jq (?i)^https://app\.cj\.sina\.com\.cn/api/deal/index\? '(. as $__original | try del(.data.banner) catch $__original)'
http-response-jq (?i)^https://app\.cj\.sina\.com\.cn/clientSetting/api/start/init\? '(. as $__original | try del(.result.data.search_ad) catch $__original) | (. as $__original | try del(.result.data.center_ads) catch $__original) | (. as $__original | try del(.result.data.banner_new_tagid) catch $__original) | (. as $__original | try del(.result.data.ad_hasAddScreenParam) catch $__original) | (. as $__original | try del(.result.data.us_trade) catch $__original) | (. as $__original | try del(.result.data.open_account) catch $__original) | (. as $__original | try del(.result.data.us_hq_trade) catch $__original)'
http-response-jq (?i)^https://(newscj\.xincai\.com|news\.cj\.sina\.cn)/app/v1/feed\? '.data.feed.data |= map(select((.author // "") != ""))'

[Map Local]
(?i)^https://news\.cj\.sina\.cn/search/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://search\.cj\.sina\.cn/stock/get_index_new\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://news\.cj\.sina\.cn/search/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://recommend\.cj\.sina\.cn/app/v2/search/discovery$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://quotes\.sina\.com\.cn/cn/api/openapi\.php/PriceChangeService\.getSearchList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.cj.sina.com.cn, news.cj.sina.cn, search.cj.sina.cn, recommend.cj.sina.cn, quotes.sina.com.cn, newscj.xincai.com
h2 = true
