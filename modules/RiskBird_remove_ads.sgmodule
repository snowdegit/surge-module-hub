#!version=2026.11.15.2
#!name=风鸟去广告 · Surge
#!desc=移除首页信息流和轮播图
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://kelee.one/Tool/Loon/Lpx/RiskBird_remove_ads.lpx
# Generated port; device validation pending. See catalog compatibility notes.

[Map Local]
(?i)^https://m\.riskbird\.com/prod-qbb-api/user/getBannerList data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://m\.riskbird\.com/prod-qbb-api/searchHotEnt data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
RiskBird_remove_ads-response = type=http-response, pattern="(?i)(?:^https://m\\.riskbird\\.com/prod-qbb-api/query/person/personRecommend)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/RiskBird_remove_ads-response.js, requires-body=true, binary-body-mode=false, timeout=10

[MITM]
hostname = %APPEND% m.riskbird.com
h2 = true
