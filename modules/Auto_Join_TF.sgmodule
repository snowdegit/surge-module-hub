#!version=2026.11.15.2
#!name=自动加入TestFlight · Surge
#!desc=自动监控TestFlight名额，一旦有新的名额即刻加入。
#!author=奶思[https://github.com/fmz200], DecoAri[https://github.com/DecoAri], xream[https://github.com/xream]
# Source: https://kelee.one/Tool/Loon/Lpx/Auto_Join_TF.lpx
# Generated port; device validation pending. See catalog compatibility notes.
#!arguments=CaptureAccountToken:false,RunTask:false,RunMonitor:true,TaskCron:0 0/2 * * * *,TaskMonitor:0 * * * * *,proxy_policy:PROXY
#!arguments-desc=参数沿用上游默认值；修改后重新启用模块。

[Rule]
DOMAIN, testflight.apple.com, {{{proxy_policy}}}

[Script]
Auto_Join_TF-request = type=http-request, pattern="(?i)(?:^https?://testflight\\.apple\\.com/v3/accounts/.*/apps$)", script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Auto_Join_TF-request.js, requires-body=false, binary-body-mode=false, timeout=10, argument="{\"CaptureAccountToken\":\"{{{CaptureAccountToken}}}\",\"RunTask\":\"{{{RunTask}}}\",\"RunMonitor\":\"{{{RunMonitor}}}\",\"TaskCron\":\"{{{TaskCron}}}\",\"TaskMonitor\":\"{{{TaskMonitor}}}\"}"
#!REQUIREMENT '{{{RunTask}}}'=='true' Auto_Join_TF-task-1 = type=cron, script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Auto_Join_TF-task-1.js, timeout=600, cronexp="{{{TaskCron}}}", argument="{\"CaptureAccountToken\":\"{{{CaptureAccountToken}}}\",\"RunTask\":\"{{{RunTask}}}\",\"RunMonitor\":\"{{{RunMonitor}}}\",\"TaskCron\":\"{{{TaskCron}}}\",\"TaskMonitor\":\"{{{TaskMonitor}}}\"}"
#!REQUIREMENT '{{{RunMonitor}}}'=='true' Auto_Join_TF-task-2 = type=cron, script-path=https://raw.githubusercontent.com/snowdegit/surge-module-hub/main/scripts/Auto_Join_TF-task-2.js, timeout=30, cronexp="{{{TaskMonitor}}}", argument="{\"CaptureAccountToken\":\"{{{CaptureAccountToken}}}\",\"RunTask\":\"{{{RunTask}}}\",\"RunMonitor\":\"{{{RunMonitor}}}\",\"TaskCron\":\"{{{TaskCron}}}\",\"TaskMonitor\":\"{{{TaskMonitor}}}\"}"
